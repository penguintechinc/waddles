package waddle:bundle@1.0.0;

// `world stage-tools` (P3b bundle-to-bundle tool invoke). Own file so the FROZEN
// `stage`/`stage-next`/`stage-v2` worlds in `stage.wit` stay untouched (their
// records are baked into compiled components).

/// Host import: call another bundle's exported tool. The stage is the sole
/// authority -- it gates, resolves and runs the target under the target's OWN
/// grants; the caller can never name the community/tenant/actor.
interface tool {
  variant tool-error {
    /// No approved grant for this caller/target/tool.
    not-granted,
    /// Grant present but the kind matrix forbids it (e.g. app to app).
    forbidden,
    /// The host-computed remaining budget was exhausted.
    timeout,
    /// Nesting beyond the host depth cap.
    depth-exceeded,
    /// The target bundle has no free instance slot.
    pool-exhausted,
    /// Unknown, unloaded, stale or digest-mismatched target.
    target-unavailable,
    /// Malformed or oversized target/tool/args/idempotency-key.
    invalid-args(string),
  }

  /// `args`/result are canonical JSON bytes. Writes require an
  /// `idempotency-key` (retry-safe).
  invoke: func(target: string, tool: string, args: list<u8>, idempotency-key: option<string>)
    -> result<list<u8>, tool-error>;
}

/// Guest export: run one of this bundle's own exported tools.
interface tool-provider {
  use tool.{tool-error};
  call: func(name: string, args: list<u8>) -> result<list<u8>, tool-error>;
}

/// `stage-v2`'s imports (numeric scope) plus `tool`; exports only
/// `tool-provider`. Whoever extends `stage-v2` with a capability MUST mirror
/// it here.
world stage-tools {
  import context-v2;
  import http;
  import kv;
  import db;
  import relay;
  import %flags;
  import log;
  import clock;
  import metrics;
  import overlay;
  import reputation;
  import economy;
  import identity;
  import ai;
  import media;
  import platform-table;
  import object-storage;
  import kv-v2;
  import db-v2;
  import tool;
  import gameserver-net;
  import authz;

  export tool-provider;
}

/// Chat bundles that call services retain the frozen stage-next exports.
/// Tool imports are additive in a new world; existing worlds stay unchanged.
world stage-next-tools {
  include stage-next;
  import tool;
}

/// Host-mediated game-server network access (RCON / TCP / UDP). APPEND-ONLY interface.
/// The guest names an admin-registered connection by UUID; the HOST resolves it (scoped to the
/// invoking tenant+community), runs the SSRF guard on the resolved IP, performs the RCON login
/// with the stored password (it never enters the guest) and enforces rate limits, deadlines and
/// byte budgets. Gated by the `gameserver.net` permission (dangerous, first-party core only).
interface gameserver-net {
  variant error {
    /// Policy refusal: not registered, forbidden address, rate limited, too many sessions,
    /// rejected command. The string is a fixed machine code (never an address or secret).
    denied(string),
    unreachable,
    timeout,
    /// The server rejected the host-side RCON login.
    auth-failed,
    /// A byte budget (in or out) would be exceeded.
    too-large,
    /// Host failure; detail is host-logged only.
    backend(string),
  }

  enum scheme { source-rcon, minecraft-rcon }

  /// An open, host-budgeted TCP session; dropping it closes the socket.
  resource tcp {
    write-all: func(bytes: list<u8>) -> result<_, error>;
    /// One read of at most `max` bytes; an empty list means the peer closed.
    read: func(max: u32) -> result<list<u8>, error>;
  }

  /// Opens an AUTHENTICATED RCON session (the host performs the login).
  rcon-open: func(server: string, scheme: scheme) -> result<tcp, error>;
  /// Opens an unauthenticated TCP session (Minecraft status ping).
  tcp-open: func(server: string) -> result<tcp, error>;
  /// One UDP request/response (A2S); the response is at most `max-response` (<= 1400) bytes.
  udp-exchange: func(server: string, payload: list<u8>, max-response: u32) -> result<list<u8>, error>;
}

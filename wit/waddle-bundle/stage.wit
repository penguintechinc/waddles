// Normative copy. Source of truth: `waddle:bundle/stage@1.0.0`, spec
// `docs/superpowers/specs/2026-09-14-rust-data-plane-design.md` SS6.5.
//
// Every consumer (bundle-compiler's import-allowlist validator, the
// executor, and all three Tier-1 SDKs) references this exact file by path
// `wit/waddle-bundle/stage.wit` and never inlines a copy. On any conflict
// between this file and the spec prose, the spec wins -- open a PR here to
// reconcile, never silently diverge.
package waddle:bundle@1.0.0;

/// Values that cross the host boundary. WIT has no dynamic JSON value, so
/// every open-ended structure is carried as canonical UTF-8 JSON text and
/// validated on both sides.
interface types {
  record platform-event {
    platform: string,
    event-type: string,
    actor: option<string>,
    /// Canonical JSON object text. Never a scalar or array.
    payload-json: string,
    /// RFC 3339 UTC, millisecond precision.
    occurred-at: string,
  }

  record stage-envelope {
    tenant: string,
    community: option<string>,
    app-id: string,
    stage: string,
    event: platform-event,
    ts: string,
    target-app-id: option<string>,
    /// W3C traceparent, when the stage had one.
    trace-context: option<string>,
  }

  record transport-result {
    ok: bool,
    status: option<u16>,
    detail: option<string>,
    provider-message-id: option<string>,
  }

  record transport-error {
    /// The single field the action stage branches on.
    retryable: bool,
    code: string,
    message: string,
    retry-after-ms: option<u32>,
  }

  /// Returned by a stage export the bundle does not implement.
  record unsupported-stage {
    stage: string,
  }
}

/// Immutable, per-call scope. Capability: always granted.
interface context {
  record bundle-context {
    tenant: string,
    community: option<string>,
    app-id: string,
    feature: string,
    version: string,
    /// The Valkey stream entry id of the event being processed. Stable and
    /// unique per delivery target; the de-duplication key a bundle records
    /// to stay idempotent under at-least-once redelivery (spec SS5.4).
    message-id: string,
    /// Resolved 3-tier config (activation > tenant availability > bundle default),
    /// as canonical JSON object text.
    config-json: string,
  }

  get-context: func() -> bundle-context;
}

/// Guarded outbound HTTP. Capability: granted only when `egress` is non-empty.
interface http {
  record header { name: string, value: string }

  record request {
    method: string,
    url: string,
    headers: list<header>,
    body: option<list<u8>>,
    /// Header name -> secret reference name. The stage resolves the reference
    /// and injects the header; the secret value never enters the component.
    secret-refs: list<tuple<string, string>>,
  }

  record response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
    truncated: bool,
  }

  variant error {
    denied(string),
    timeout,
    too-large(u64),
    rate-limited(u32),
    transport(string),
  }

  send: func(req: request) -> result<response, error>;
}

/// Bundle-scoped key/value, stored under the bundle's own `...:state` key.
/// Capability: always granted.
interface kv {
  variant error { too-large(u64), backend(string) }

  get: func(key: string) -> result<option<list<u8>>, error>;
  /// ttl-seconds = 0 means "no expiry"; the host clamps to KV_MAX_TTL_S.
  set: func(key: string, value: list<u8>, ttl-seconds: u32) -> result<_, error>;
  delete: func(key: string) -> result<_, error>;
  increment: func(key: string, delta: s64, ttl-seconds: u32) -> result<s64, error>;
}

/// Structured table ops against the bundle's OWN single table in the
/// shared Postgres instance (`app_core`/`app_community` schema), enforced
/// host-side by `core/bundle_host_db` under the least-privilege
/// `waddles_bundle_runtime` role: every row is scoped server-side to the
/// invocation's authenticated (tenant, community, app_id) -- a bundle never
/// supplies a schema/table/column name or a tenant/community argument;
/// every op implicitly targets this app's own provisioned table.
/// Capability: granted only when `data.tables` is non-empty (manifest
/// permission `storage.tables`).
///
/// **No raw SQL crosses this boundary, ever** (design doc SS1 round-1
/// CRITICAL finding) -- this interface replaces the earlier
/// `execute(statement, params)` raw-SQL shape; see
/// `core/bundle_host_db`'s own crate doc for the full design rationale.
interface db {
  variant value {
    null-value,
    bool-value(bool),
    int-value(s64),
    float-value(f64),
    text-value(string),
    bytes-value(list<u8>),
  }

  /// One `(column, value)` pair -- WIT has no map type, so `insert`/
  /// `update`'s column-values are carried as a list of these.
  record column-value {
    column: string,
    value: value,
  }

  /// `query`'s row ordering. `column` sorts by a declared column or a
  /// fixed sortable platform column (`row-id`/`version`/`created-at`/
  /// `updated-at`), validated host-side; `random` is `ORDER BY random()`,
  /// typically paired with `limit: 1` for a uniformly-random single row
  /// (e.g. a quote/8-ball-style bundle). Omitted (the `query` func's
  /// `order-by` param is `option<order-by>`) defaults to stable
  /// `row-id` ascending.
  record order-column {
    name: string,
    descending: bool,
  }
  variant order-by {
    column(order-column),
    random,
  }

  /// One row as returned to the guest: `row-id`/`version` are the
  /// platform-owned identity/optimistic-concurrency columns; `columns`
  /// echoes back exactly the declared-column values, never a platform
  /// column.
  record row {
    row-id: string,
    version: u64,
    columns: list<column-value>,
  }

  variant error {
    denied(string),
    invalid-column(string),
    invalid-value(string),
    not-found,
    conflict(string),
    quota-exceeded(string),
    timeout,
    backend(string),
  }

  /// Inserts one row; returns the platform-assigned `row-id`/`version`
  /// alongside the stored columns.
  insert: func(column-values: list<column-value>) -> result<row, error>;
  /// Fetches one row by its platform `row-id`.
  get: func(row-id: string) -> result<row, error>;
  /// Bounded, orderable list of this app's own rows. `limit` is clamped
  /// host-side regardless of what is requested; `order-by` defaults to
  /// `row-id` ascending when absent.
  query: func(limit: u32, offset: u32, order-by: option<order-by>) -> result<list<row>, error>;
  /// Updates one row, gated on `expected-version` (optimistic concurrency)
  /// -- a mismatch or missing row returns `conflict`/`not-found`.
  update: func(row-id: string, expected-version: u64, column-values: list<column-value>)
    -> result<row, error>;
  /// Deletes one row, gated on `expected-version` the same way as `update`.
  delete: func(row-id: string, expected-version: u64) -> result<_, error>;
}

/// Push onto a provider-scoped outbound relay queue owned by svc-ingest.
/// Capability: granted only to action-stage bundles.
interface relay {
  variant error { denied(string), backend(string) }

  push: func(provider: string, message-json: string) -> result<_, error>;
}

/// Bundle-pushable overlay widgets rendered by svc-presentation-rust
/// (issue #457). Additive, `stage-next`-only (spec SS5-style world
/// versioning, see `world stage-next` below) -- `world stage` (1.0.0)
/// never imports this. Capability: granted only when permission
/// `overlay.media` is held (`bundle_capability_gate::permission::
/// PermissionFamily::OverlayMedia`); the community/token resolution is
/// entirely server-derived from the invocation scope
/// (`AppScopedResource::Overlay`, same as every other `AppScoped` family)
/// -- a bundle never supplies or sees a community id, token, or websocket
/// address here.
///
/// Wire shape mirrors `core/overlay_schema` (Rust, the single source of
/// truth also consumed by svc-presentation-rust, svc-streaming-rust and
/// the webui) byte-for-byte -- `surface` is that crate's `Surface` enum,
/// `payload-json` round-trips through its `OverlayPush` serde type.
interface overlay {
  use types.{transport-result, transport-error};

  /// The unified surface id set a bundle may target -- kept in lockstep
  /// with `core/overlay_schema::Surface` (C3); a surface added to one must
  /// be added to the other in the same PR.
  enum surface {
    full-screen,
    media,
    crawler,
    music,
    alert-box,
    chat,
    goals,
    ticker,
    image,
  }

  /// One widget this bundle offers the overlay designer's palette
  /// (issue #458 "Bundle widgets"). Declarative only -- `descriptor-json`
  /// is host-validated against a fixed schema (size/anchor/data-binding
  /// fields), never raw HTML/CSS/JS; sandboxed custom-code widgets are a
  /// separate, not-yet-built, Enterprise-only surface per #458's
  /// architecture notes, out of scope for this interface.
  record widget-descriptor {
    /// This bundle's own namespaced id, stable across pushes/registrations.
    widget-id: string,
    display-name: string,
    surface: surface,
    /// Canonical JSON object text: default size/anchor + declared
    /// data-binding fields.
    descriptor-json: string,
  }

  /// Declares (or idempotently updates) one widget for the designer's
  /// palette. Does not push any live content -- see `push`.
  register-widget: func(widget: widget-descriptor) -> result<transport-result, transport-error>;

  /// Pushes one content update for `widget-id` out to every live overlay
  /// client watching `surface`, fanned out over svc-presentation-rust's
  /// SSE/websocket channel. `payload-json` is a canonical JSON object
  /// matching the surface's documented fields (`core/overlay_schema`'s
  /// `OverlayPush` variants) -- `title`/`body`/`image-url` for
  /// `full-screen`/`media`, `text` for `crawler`/`ticker`, etc.
  push: func(widget-id: string, surface: surface, payload-json: string)
    -> result<transport-result, transport-error>;
}

/// Stream-lifecycle hooks a bundle exports to react to svc-streaming-rust
/// events (issue #456). Additive, `stage-next`-only, modeled on
/// `scheduled-stage`'s "export a hook, `none`/`unsupported-stage` means
/// not interested" shape -- a bundle not implementing streaming behavior
/// returns `unsupported-stage` from every hook (SDK default), exactly as
/// an existing bundle may already do for `process-stage`/`action-stage`.
/// Capability: the component is linked with this export registered only
/// when permission `streaming.lifecycle.subscribe` is held -- enforcement
/// mechanics are host-wiring, deferred past this contract (see
/// `bundle_capability_gate::permission::PermissionFamily::
/// StreamingLifecycleSubscribe`).
interface streaming-lifecycle {
  use types.{platform-event, unsupported-stage};

  record stream-info {
    stream-id: string,
    community: string,
    platform: string,
    /// RFC 3339 UTC, millisecond precision.
    started-at: string,
  }

  record segment-info {
    stream-id: string,
    segment-index: u32,
    segment-url: string,
    duration-ms: u32,
  }

  record recording-info {
    stream-id: string,
    recording-url: string,
    duration-ms: u32,
    size-bytes: u64,
  }

  /// Returning `some` emits a platform-event back onto the normal
  /// downstream path (e.g. an announcement); `none` means "side effects
  /// only".
  on-start: func(info: stream-info) -> result<option<platform-event>, unsupported-stage>;
  on-stop: func(info: stream-info) -> result<option<platform-event>, unsupported-stage>;
  on-segment: func(segment: segment-info) -> result<option<platform-event>, unsupported-stage>;
  on-recording-ready: func(recording: recording-info)
    -> result<option<platform-event>, unsupported-stage>;
}

/// Community-scoped reputation points (issue #726, the reference host
/// capability every later bundle-called host import -- economy #714,
/// streaming-lifecycle #716 -- reuses). Additive, `stage-next`-only:
/// `world stage` (1.0.0) never imports this.
///
/// Capability: `reputation.read` (`get`) / `reputation.community.write`
/// (`adjust`), both gated host-side by `core/bundle_capability_gate` with
/// a `ReputationScoped` resource -- the bundle names only a TARGET user
/// (`user`, a UUID string); the community, tenant and app are always
/// server-derived from the invocation scope, never a guest argument. The
/// host additionally verifies, at call time, that `user` is a member of the
/// invocation's community (`MembershipCheck`, then re-checked inside the
/// store's own transaction), enforces the catalog's per-call/per-user-daily
/// delta caps, and writes one `bundle_reputation_adjustments` ledger row
/// per applied adjustment in the same transaction as the score update.
///
/// Wire note: `penguin-bundle-host`'s closed `CapabilityKind` has no
/// `reputation` member yet, so the executor carries these calls as
/// `capability = db`, `op = "reputation.get"|"reputation.adjust"`; the
/// stage dispatches on the op prefix BEFORE the `db` (`storage.tables`)
/// path, and the gate -- not the wire kind -- is what authorizes them.
interface reputation {
  variant error {
    /// The gate denied the call (not granted, delta out of the declared
    /// bounds, quota/rate exceeded, instance policy, ...); carries the
    /// gate's stable denial code.
    denied(string),
    /// `user` is not a member of this invocation's community.
    not-a-member,
    /// The user's rolling-24h absolute-delta cap would be exceeded.
    daily-cap-exceeded,
    /// Malformed argument (non-UUID `user`, empty/oversized/non-code
    /// `reason`, ...).
    invalid(string),
    /// The capability is not wired/enabled on this host.
    unavailable(string),
    backend(string),
  }

  /// Current community-scoped score for `user` (0 for a member with no
  /// adjustments yet).
  get: func(user: string) -> result<s64, error>;

  /// Atomically adds `delta` (may be negative) to `user`'s community score
  /// and returns the NEW score. `reason` is a short machine code
  /// (`[a-z0-9._:-]`, <= 100 chars) recorded in the audit ledger -- never
  /// free text or PII.
  adjust: func(user: string, delta: s32, reason: string) -> result<s64, error>;
}

/// The shared community currency (issue #714), cloned from `reputation`'s
/// recipe. Additive, `stage-next`-only: `world stage` (1.0.0) never imports
/// this.
///
/// Capabilities, each gated host-side by `core/bundle_capability_gate` with an
/// `EconomyScoped` resource: `economy.read` (`balance`, `leaderboard`),
/// `economy.wager` (`wager`, and `max-bet`, which reports the wager
/// capability's own limit), `economy.transfer` (`transfer`). The bundle names only TARGET users (UUID strings) and
/// amounts; the community, tenant and app are always server-derived, never a
/// guest argument. Every named user must be an active member of the
/// invocation's community (checked by the gate, then re-checked inside the
/// store's own write). Amounts are bounded by the economy's OWN quota family
/// (per-call ceiling, community-declared `max_bet`/`max_amount`, per-user and
/// per-community daily aggregates) -- not reputation's point caps.
///
/// Money never moves read-modify-write: `wager` is ONE guarded `UPDATE`
/// (`balance = balance - stake + payout WHERE balance >= stake`), so any
/// number of concurrent calls can never overdraw a balance. Every applied
/// movement writes an append-only ledger row in the same statement. A bundle
/// can only MOVE existing balance here; it can never mint beyond the
/// host-bounded payout multiple of a stake it actually held, and the total a
/// user's wagers may PAY OUT per day is capped (the mint cap is on the
/// payout, not the stake).
///
/// **Only the invocation's own actor's money moves.** The account whose funds
/// a call moves -- `wager`'s `user`, `transfer`'s `from-user` -- MUST be the
/// account that triggered this invocation (the same user `identity.
/// resolve-actor` returns); anything else is `denied("actor_mismatch")` and
/// nothing is written. A bundle can pay the actor's money TO anyone, but can
/// never pull anyone else's. Reads (`balance`, `max-bet`, `leaderboard`) are
/// not bound.
///
/// **Idempotent by construction.** The host keys every `wager`/`transfer` by
/// the event being handled plus the call's ordinal, so an event the platform
/// redelivers (after a crash, a retry) credits ONCE: the replayed call is
/// answered with the original result and moves nothing. A replay whose
/// parameters differ from the original (a re-rolled payout, a different
/// recipient) is `denied("idempotency_conflict")` and never applied. After a
/// `backend` error -- the one outcome that may or may not have committed --
/// retry the SAME call: it presents the same key and applies at most once.
///
/// Wire note: like `reputation`, calls are carried as `capability = db`,
/// `op = "economy.balance"|"economy.wager"|"economy.transfer"|
/// "economy.max_bet"|"economy.leaderboard"`; the stage dispatches on the op
/// prefix BEFORE the `db` (`storage.tables`) path, and the gate -- not the
/// wire kind -- is what authorizes them.
interface economy {
  variant error {
    /// The gate denied the call (not granted, amount out of bounds,
    /// quota/rate exceeded, instance policy, ...); carries the gate's stable
    /// denial code. Also the money-safety refusals: `actor_mismatch` (the
    /// account named as payer is not the invocation's actor),
    /// `idempotency_conflict` (a replayed call's parameters differ from the
    /// original) and `not_linked` (the actor has no resolved community
    /// identity, so nothing can be bound to them).
    denied(string),
    /// The debited user holds less than the stake/amount; carries the balance
    /// they do hold.
    insufficient-funds(u64),
    /// The stake/amount (or a wager's payout) exceeds the server-enforced
    /// cap; carries that cap (`max-bet` for a stake, `max-amount` for a
    /// transfer, `stake * 100` for a payout).
    over-cap(u64),
    /// A named user is not a member of this invocation's community.
    not-a-member,
    /// Malformed argument (non-UUID user, zero amount, self-transfer,
    /// out-of-range leaderboard limit, ...).
    invalid(string),
    /// The capability is not wired/enabled on this host.
    unavailable(string),
    backend(string),
  }

  /// One leaderboard row: a member (UUID string only -- no names) and balance.
  record entry {
    user: string,
    balance: s64,
  }

  /// `user`'s community balance (0 for a member who holds nothing yet).
  balance: func(user: string) -> result<s64, error>;

  /// Atomically debits `stake` and credits `payout` (net `payout - stake`;
  /// `payout` is 0 for a loss) and returns the NEW balance. `user` MUST be the
  /// invocation's actor (`denied("actor_mismatch")` otherwise). `stake` must be
  /// >= 1, within `max-bet`, and held by the user; `payout` may be at most
  /// 100x `stake` and counts against the daily PAYOUT (mint) cap. Idempotent
  /// per event and call ordinal: a replay returns the original balance.
  wager: func(user: string, stake: u64, payout: u64) -> result<s64, error>;

  /// Atomically moves `amount` (>= 1) from `from-user` to `to-user` (both
  /// members, distinct). `from-user` MUST be the invocation's actor
  /// (`denied("actor_mismatch")` otherwise); `to-user` may be any member.
  /// Within the community-declared `max_amount`. Idempotent per event and call
  /// ordinal: a replay moves nothing.
  transfer: func(from-user: string, to-user: string, amount: u64) -> result<_, error>;

  /// The largest stake `user` may place right now: the server-enforced
  /// per-call cap (the grant's declared `max_bet`, clamped to the catalog
  /// ceiling), bounded by what the user actually holds. Requires the
  /// `economy.wager` grant; moves no money and is only rate limited.
  max-bet: func(user: string) -> result<s64, error>;

  /// The community's top `limit` (1..=100) members by balance, highest first.
  leaderboard: func(limit: u32) -> result<list<entry>, error>;
}

/// Resolves WHO an invocation is about to the community `user-uuid` that
/// `reputation` and `economy` name their targets by (the prerequisite of every
/// points-game bundle: `!gamble` needs the actor, `!steal @user`/`!duel @user`
/// need the actor AND the mentioned target). Additive, `stage-next`-only:
/// `world stage` (1.0.0) never imports this.
///
/// Capability: `identity.resolve` (`bundle_capability_gate::permission::
/// PermissionFamily::IdentityResolve`), gated host-side like every other
/// import; a bundle that never declared it gets `denied("not_granted")`.
///
/// **UUID-only, PII-safe by construction.** The bundle receives a community
/// `user-uuid` (the pseudonymous identity token `community_members.user_uuid`
/// holds -- the same value `economy`/`reputation` then accept) and NEVER a
/// platform user id, handle, display name or any other raw identity. The
/// bundle supplies no tenant, community, platform or user argument that
/// selects WHOSE identity is resolved:
///
/// * `resolve-actor` takes no argument at all -- the host resolves the
///   TRIGGERING actor of the invocation in flight from the event it
///   delivered (the platform account id it carries), scoped to the
///   invocation's (tenant, community). A bundle can never ask about anyone
///   but the person whose message triggered it.
/// * `resolve-mention` takes the opaque mention token the bundle ALREADY
///   holds -- the `<uuid>` inside a `{user:<uuid>}` placeholder it was shown
///   in the message text (or, only when the operator has switched inbound
///   PII tokenization off, the raw `<@123>` / `@handle` reference it was
///   shown). The host keeps a per-invocation table of the references THIS
///   message carried and answers only for those, so the call is NOT a
///   directory lookup: an unknown token/handle is `not-found` and a bundle
///   cannot probe whether an arbitrary handle exists. A free-text handle is
///   resolved inside hub-api's PII boundary (`IdentityService.ResolveHandle`,
///   tenant-scoped; never guessed -- ambiguous is an error), then confirmed
///   an active member of THIS community.
///
/// **Fail-closed, never a wrong or default UUID.** Every refusal is an
/// explicit error; there is no code path that returns a pseudonym, a platform
/// id or a placeholder in the success position, and a member whose
/// `user_uuid` is still NULL (identity not yet resolved) is `not-linked`, not
/// a made-up value.
///
/// Wire note: like `reputation`/`economy`, calls are carried as
/// `capability = db`, `op = "identity.resolve_actor"|"identity.resolve_mention"`;
/// the stage dispatches on the op prefix BEFORE the `db` (`storage.tables`)
/// path, and the gate -- not the wire kind -- is what authorizes them.
interface identity {
  variant error {
    /// The gate denied the call (not granted, rate limited, instance policy,
    /// ...); carries the gate's stable denial code.
    denied(string),
    /// The identity exists but has no resolved community `user-uuid` yet
    /// (`community_members.user_uuid` is NULL), or the triggering event
    /// carried no platform account id to resolve. The bundle should tell the
    /// user their account is not linked -- never proceed with a guess.
    not-linked,
    /// The identity resolves but is not an active member of this
    /// invocation's community.
    not-a-member,
    /// The mention token/handle is not one this message carried, or matches
    /// no identity in the tenant.
    not-found,
    /// A free-text handle matches more than one identity in the tenant; the
    /// host never guesses between them.
    ambiguous,
    /// Malformed argument (empty/oversized/ill-formed mention token, a
    /// tenant-wide activation with no community, ...).
    invalid(string),
    /// The capability is not wired/enabled on this host (flag OFF, store or
    /// hub-api resolver not provisioned, hub-api unreachable).
    unavailable(string),
    backend(string),
  }

  /// The community `user-uuid` of the actor whose event triggered this
  /// invocation. No argument: the host derives the actor.
  resolve-actor: func() -> result<string, error>;

  /// The community `user-uuid` of the user a mention in the triggering
  /// message refers to. `token` is the mention token the bundle was shown
  /// (see the interface doc); the call resolves ONLY references present in
  /// this invocation's message.
  resolve-mention: func(token: string) -> result<string, error>;
}

/// PostHog flag + license entitlement, two-gate, cached, fail-open to the
/// supplied default. Capability: always granted.
///
/// Named `%flags` because `flags` is a reserved WIT keyword (the `flags`
/// bitset type); `%` is WIT's standard identifier-escape and does not
/// change the interface's actual name -- it resolves to
/// `waddle:bundle/flags@1.0.0`, matching the spec and wire protocol
/// verbatim.
interface %flags {
  enabled: func(key: string, default-value: bool) -> bool;
  /// "free" | "professional" | "enterprise"
  tier: func() -> string;
}

/// Sanitized, levelled logging into the stage's OTel pipeline.
/// Capability: always granted.
interface log {
  enum level { error, warn, info, debug }
  /// `fields-json` is a canonical JSON object; the host sanitizes it with the
  /// penguin logging SENSITIVE_KEYS rule before emission.
  write: func(lvl: level, message: string, fields-json: string);
}

/// Capability: always granted.
interface clock {
  /// Milliseconds since the Unix epoch, as the stage sees it.
  now-millis: func() -> u64;
  /// RFC 3339 UTC, millisecond precision.
  now-rfc3339: func() -> string;
  /// Monotonic nanoseconds, for in-bundle duration measurement only.
  monotonic-nanos: func() -> u64;
}

interface process-stage {
  use types.{platform-event, unsupported-stage};
  /// `none` means "no reply"; the event is dropped, exactly as v1's
  /// `transform() -> PlatformEvent | None`.
  transform: func(event: platform-event) -> result<option<platform-event>, unsupported-stage>;
}

interface action-stage {
  use types.{stage-envelope, transport-result, transport-error};
  /// `config` is canonical JSON object text (the resolved 3-tier config).
  dispatch: func(envelope: stage-envelope, config: string)
    -> result<transport-result, transport-error>;
}

world stage {
  import context;
  import http;
  import kv;
  import db;
  import relay;
  import %flags;
  import log;
  import clock;

  export process-stage;
  export action-stage;
}

/// Additive next-version world (this PR establishes it) -- every `world
/// stage` (1.0.0) import/export stays byte-for-byte, plus the new
/// `overlay` import and `streaming-lifecycle` export landed here (C1,
/// issues #456/#457). `world stage` above is completely untouched: an
/// existing 1.0.0 component never references `stage-next` and is
/// unaffected by anything added to it.
///
/// **Named `stage-next`, NOT `stage-v1-1` or `stage-v1_1`** (the
/// provisional name `docs/superpowers/specs/2026-09-28-wit-stage-v1-1-
/// design.md` SS5 sketches): a trailing bare-digit segment after a hyphen
/// (`-1`) is INVALID WIT kebab-case grammar (each `-`-separated segment
/// must start with a letter, not a digit) -- `wasm-tools component wit`'s
/// pretty-printer round-trip silently accepted `world stage-v1-1` when
/// this was verified locally, but `wit-bindgen` 0.44.0's parser (the one
/// `sdk/waddle-sdk-rs` actually builds against via `wit_bindgen::
/// generate!`) correctly rejects it (`invalid character in identifier
/// '1'`), which only surfaced in CI. **Flag for whoever lands
/// moderation/scheduled-triggers/db-batch**: that design doc's own
/// `stage-v1_1` naming will hit this exact grammar error too -- use
/// `stage-next` (or another non-digit-leading-segment name), not
/// `stage-v1_1`/`stage-v1-1`.
///
/// **Package version intentionally NOT bumped** (still `waddle:bundle@
/// 1.0.0`) -- that design doc also sketches a package-version bump
/// (`@1.1.0`) alongside a frozen `@1.0.0` `world stage`, but per-item
/// semver pinning that would require (two differently-versioned
/// `interface types { ... }` declarations in one file) is not supported
/// syntax in this repo's pinned wasm-tools 1.259.0 WIT parser (verified:
/// `interface foo@1.0.0 { ... }` is a parse error). A single package
/// version with two worlds -- this file's actual approach -- is the
/// verified-safe additive mechanism; reconcile with that design doc's own
/// versioning story in whichever PR lands moderation/scheduled-triggers/
/// db-batch.
///
/// **Whoever lands moderation/scheduled-triggers/db-batch extends THIS
/// SAME `stage-next` world** (add `import moderation;`/`export
/// scheduled-stage;`/the `db` interface's `execute-batch` addition here)
/// rather than declaring a second next-version world -- WIT worlds are
/// not open/mergeable across files, so a second same-purpose world
/// definition would be a hard duplicate-world conflict, not an extension.
world stage-next {
  import context;
  import http;
  import kv;
  import db;
  import relay;
  import %flags;
  import log;
  import clock;
  import overlay;
  import reputation;
  import economy;
  import identity;

  export process-stage;
  export action-stage;
  export streaming-lifecycle;
}

// Normative copy. Source of truth: `waddle:bundle/stage@1.0.0`, spec
// `docs/superpowers/specs/2026-09-14-rust-data-plane-design.md` SS6.5.
//
// Every consumer (bundle-compiler's import-allowlist validator, the
// executor, and all three Tier-1 SDKs) references this exact file by path
// `wit/waddle-bundle/stage.wit` and never inlines a copy. On any conflict
// between this file and the spec prose, the spec wins -- open a PR here to
// reconcile, never silently diverge.
package waddle:bundle@1.0.0;

/// Values that cross the host boundary. WIT has no dynamic JSON value, so
/// every open-ended structure is carried as canonical UTF-8 JSON text and
/// validated on both sides.
interface types {
  record platform-event {
    platform: string,
    event-type: string,
    actor: option<string>,
    /// Canonical JSON object text. Never a scalar or array.
    payload-json: string,
    /// RFC 3339 UTC, millisecond precision.
    occurred-at: string,
  }

  record stage-envelope {
    tenant: string,
    community: option<string>,
    app-id: string,
    stage: string,
    event: platform-event,
    ts: string,
    target-app-id: option<string>,
    /// W3C traceparent, when the stage had one.
    trace-context: option<string>,
  }

  record transport-result {
    ok: bool,
    status: option<u16>,
    detail: option<string>,
    provider-message-id: option<string>,
  }

  record transport-error {
    /// The single field the action stage branches on.
    retryable: bool,
    code: string,
    message: string,
    retry-after-ms: option<u32>,
  }

  /// Returned by a stage export the bundle does not implement.
  record unsupported-stage {
    stage: string,
  }
}

/// Immutable, per-call scope. Capability: always granted.
interface context {
  record bundle-context {
    tenant: string,
    community: option<string>,
    app-id: string,
    feature: string,
    version: string,
    /// The Valkey stream entry id of the event being processed. Stable and
    /// unique per delivery target; the de-duplication key a bundle records
    /// to stay idempotent under at-least-once redelivery (spec SS5.4).
    message-id: string,
    /// Resolved 3-tier config (activation > tenant availability > bundle default),
    /// as canonical JSON object text.
    config-json: string,
  }

  get-context: func() -> bundle-context;
}

/// Guarded outbound HTTP. Capability: granted only when `egress` is non-empty.
interface http {
  record header { name: string, value: string }

  record request {
    method: string,
    url: string,
    headers: list<header>,
    body: option<list<u8>>,
    /// Header name -> secret reference name. The stage resolves the reference
    /// and injects the header; the secret value never enters the component.
    secret-refs: list<tuple<string, string>>,
  }

  record response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
    truncated: bool,
  }

  variant error {
    denied(string),
    timeout,
    too-large(u64),
    rate-limited(u32),
    transport(string),
  }

  send: func(req: request) -> result<response, error>;
}

/// Bundle-scoped key/value, stored under the bundle's own `...:state` key.
/// Capability: always granted.
interface kv {
  variant error { too-large(u64), backend(string) }

  get: func(key: string) -> result<option<list<u8>>, error>;
  /// ttl-seconds = 0 means "no expiry"; the host clamps to KV_MAX_TTL_S.
  set: func(key: string, value: list<u8>, ttl-seconds: u32) -> result<_, error>;
  delete: func(key: string) -> result<_, error>;
  increment: func(key: string, delta: s64, ttl-seconds: u32) -> result<s64, error>;
}

/// Structured table ops against the bundle's OWN single table in the
/// shared Postgres instance (`app_core`/`app_community` schema), enforced
/// host-side by `core/bundle_host_db` under the least-privilege
/// `waddles_bundle_runtime` role: every row is scoped server-side to the
/// invocation's authenticated (tenant, community, app_id) -- a bundle never
/// supplies a schema/table/column name or a tenant/community argument;
/// every op implicitly targets this app's own provisioned table.
/// Capability: granted only when `data.tables` is non-empty (manifest
/// permission `storage.tables`).
///
/// **No raw SQL crosses this boundary, ever** (design doc SS1 round-1
/// CRITICAL finding) -- this interface replaces the earlier
/// `execute(statement, params)` raw-SQL shape; see
/// `core/bundle_host_db`'s own crate doc for the full design rationale.
interface db {
  variant value {
    null-value,
    bool-value(bool),
    int-value(s64),
    float-value(f64),
    text-value(string),
    bytes-value(list<u8>),
  }

  /// One `(column, value)` pair -- WIT has no map type, so `insert`/
  /// `update`'s column-values are carried as a list of these.
  record column-value {
    column: string,
    value: value,
  }

  /// `query`'s row ordering. `column` sorts by a declared column or a
  /// fixed sortable platform column (`row-id`/`version`/`created-at`/
  /// `updated-at`), validated host-side; `random` is `ORDER BY random()`,
  /// typically paired with `limit: 1` for a uniformly-random single row
  /// (e.g. a quote/8-ball-style bundle). Omitted (the `query` func's
  /// `order-by` param is `option<order-by>`) defaults to stable
  /// `row-id` ascending.
  record order-column {
    name: string,
    descending: bool,
  }
  variant order-by {
    column(order-column),
    random,
  }

  /// One row as returned to the guest: `row-id`/`version` are the
  /// platform-owned identity/optimistic-concurrency columns; `columns`
  /// echoes back exactly the declared-column values, never a platform
  /// column.
  record row {
    row-id: string,
    version: u64,
    columns: list<column-value>,
  }

  variant error {
    denied(string),
    invalid-column(string),
    invalid-value(string),
    not-found,
    conflict(string),
    quota-exceeded(string),
    timeout,
    backend(string),
  }

  /// Inserts one row; returns the platform-assigned `row-id`/`version`
  /// alongside the stored columns.
  insert: func(column-values: list<column-value>) -> result<row, error>;
  /// Fetches one row by its platform `row-id`.
  get: func(row-id: string) -> result<row, error>;
  /// Bounded, orderable list of this app's own rows. `limit` is clamped
  /// host-side regardless of what is requested; `order-by` defaults to
  /// `row-id` ascending when absent.
  query: func(limit: u32, offset: u32, order-by: option<order-by>) -> result<list<row>, error>;
  /// Updates one row, gated on `expected-version` (optimistic concurrency)
  /// -- a mismatch or missing row returns `conflict`/`not-found`.
  update: func(row-id: string, expected-version: u64, column-values: list<column-value>)
    -> result<row, error>;
  /// Deletes one row, gated on `expected-version` the same way as `update`.
  delete: func(row-id: string, expected-version: u64) -> result<_, error>;
}

/// Push onto a provider-scoped outbound relay queue owned by svc-ingest.
/// Capability: granted only to action-stage bundles.
interface relay {
  variant error { denied(string), backend(string) }

  push: func(provider: string, message-json: string) -> result<_, error>;
}

/// Bundle-pushable overlay widgets rendered by svc-presentation-rust
/// (issue #457). Additive, `stage-next`-only (spec SS5-style world
/// versioning, see `world stage-next` below) -- `world stage` (1.0.0)
/// never imports this. Capability: granted only when permission
/// `overlay.media` is held (`bundle_capability_gate::permission::
/// PermissionFamily::OverlayMedia`); the community/token resolution is
/// entirely server-derived from the invocation scope
/// (`AppScopedResource::Overlay`, same as every other `AppScoped` family)
/// -- a bundle never supplies or sees a community id, token, or websocket
/// address here.
///
/// Wire shape mirrors `core/overlay_schema` (Rust, the single source of
/// truth also consumed by svc-presentation-rust, svc-streaming-rust and
/// the webui) byte-for-byte -- `surface` is that crate's `Surface` enum,
/// `payload-json` round-trips through its `OverlayPush` serde type.
interface overlay {
  use types.{transport-result, transport-error};

  /// The unified surface id set a bundle may target -- kept in lockstep
  /// with `core/overlay_schema::Surface` (C3); a surface added to one must
  /// be added to the other in the same PR.
  enum surface {
    full-screen,
    media,
    crawler,
    music,
    alert-box,
    chat,
    goals,
    ticker,
    image,
    caption,
  }

  /// One widget this bundle offers the overlay designer's palette
  /// (issue #458 "Bundle widgets"). Declarative only -- `descriptor-json`
  /// is host-validated against a fixed schema (size/anchor/data-binding
  /// fields), never raw HTML/CSS/JS; sandboxed custom-code widgets are a
  /// separate, not-yet-built, Enterprise-only surface per #458's
  /// architecture notes, out of scope for this interface.
  record widget-descriptor {
    /// This bundle's own namespaced id, stable across pushes/registrations.
    widget-id: string,
    display-name: string,
    surface: surface,
    /// Canonical JSON object text: default size/anchor + declared
    /// data-binding fields.
    descriptor-json: string,
  }

  /// Declares (or idempotently updates) one widget for the designer's
  /// palette. Does not push any live content -- see `push`.
  register-widget: func(widget: widget-descriptor) -> result<transport-result, transport-error>;

  /// Pushes one content update for `widget-id` out to every live overlay
  /// client watching `surface`, fanned out over svc-presentation-rust's
  /// SSE/websocket channel. `payload-json` is a canonical JSON object
  /// matching the surface's documented fields (`core/overlay_schema`'s
  /// `OverlayPush` variants) -- `title`/`body`/`image-url` for
  /// `full-screen`/`media`, `text` for `crawler`/`ticker`, etc.
  push: func(widget-id: string, surface: surface, payload-json: string)
    -> result<transport-result, transport-error>;
}

/// Stream-lifecycle hooks a bundle exports to react to svc-streaming-rust
/// events (issue #456). Additive, `stage-next`-only, modeled on
/// `scheduled-stage`'s "export a hook, `none`/`unsupported-stage` means
/// not interested" shape -- a bundle not implementing streaming behavior
/// returns `unsupported-stage` from every hook (SDK default), exactly as
/// an existing bundle may already do for `process-stage`/`action-stage`.
/// Capability: the component is linked with this export registered only
/// when permission `streaming.lifecycle.subscribe` is held -- enforcement
/// mechanics are host-wiring, deferred past this contract (see
/// `bundle_capability_gate::permission::PermissionFamily::
/// StreamingLifecycleSubscribe`).
interface streaming-lifecycle {
  use types.{platform-event, unsupported-stage};

  record stream-info {
    stream-id: string,
    community: string,
    platform: string,
    /// RFC 3339 UTC, millisecond precision.
    started-at: string,
  }

  record segment-info {
    stream-id: string,
    segment-index: u32,
    segment-url: string,
    duration-ms: u32,
  }

  record recording-info {
    stream-id: string,
    recording-url: string,
    duration-ms: u32,
    size-bytes: u64,
  }

  /// Returning `some` emits a platform-event back onto the normal
  /// downstream path (e.g. an announcement); `none` means "side effects
  /// only".
  on-start: func(info: stream-info) -> result<option<platform-event>, unsupported-stage>;
  on-stop: func(info: stream-info) -> result<option<platform-event>, unsupported-stage>;
  on-segment: func(segment: segment-info) -> result<option<platform-event>, unsupported-stage>;
  on-recording-ready: func(recording: recording-info)
    -> result<option<platform-event>, unsupported-stage>;
}

/// PostHog flag + license entitlement, two-gate, cached, fail-open to the
/// supplied default. Capability: always granted.
///
/// Named `%flags` because `flags` is a reserved WIT keyword (the `flags`
/// bitset type); `%` is WIT's standard identifier-escape and does not
/// change the interface's actual name -- it resolves to
/// `waddle:bundle/flags@1.0.0`, matching the spec and wire protocol
/// verbatim.
interface %flags {
  enabled: func(key: string, default-value: bool) -> bool;
  /// "free" | "professional" | "enterprise"
  tier: func() -> string;
}

/// Sanitized, levelled logging into the stage's OTel pipeline.
/// Capability: always granted.
interface log {
  enum level { error, warn, info, debug }
  /// `fields-json` is a canonical JSON object; the host sanitizes it with the
  /// penguin logging SENSITIVE_KEYS rule before emission.
  write: func(lvl: level, message: string, fields-json: string);
}

/// Capability: always granted.
interface clock {
  /// Milliseconds since the Unix epoch, as the stage sees it.
  now-millis: func() -> u64;
  /// RFC 3339 UTC, millisecond precision.
  now-rfc3339: func() -> string;
  /// Monotonic nanoseconds, for in-bundle duration measurement only.
  monotonic-nanos: func() -> u64;
}

interface process-stage {
  use types.{platform-event, unsupported-stage};
  /// `none` means "no reply"; the event is dropped, exactly as v1's
  /// `transform() -> PlatformEvent | None`.
  transform: func(event: platform-event) -> result<option<platform-event>, unsupported-stage>;
}

interface action-stage {
  use types.{stage-envelope, transport-result, transport-error};
  /// `config` is canonical JSON object text (the resolved 3-tier config).
  dispatch: func(envelope: stage-envelope, config: string)
    -> result<transport-result, transport-error>;
}

world stage {
  import context;
  import http;
  import kv;
  import db;
  import relay;
  import %flags;
  import log;
  import clock;

  export process-stage;
  export action-stage;
}

/// Additive next-version world (this PR establishes it) -- every `world
/// stage` (1.0.0) import/export stays byte-for-byte, plus the new
/// `overlay` import and `streaming-lifecycle` export landed here (C1,
/// issues #456/#457). `world stage` above is completely untouched: an
/// existing 1.0.0 component never references `stage-next` and is
/// unaffected by anything added to it.
///
/// **Named `stage-next`, NOT `stage-v1-1` or `stage-v1_1`** (the
/// provisional name `docs/superpowers/specs/2026-09-28-wit-stage-v1-1-
/// design.md` SS5 sketches): a trailing bare-digit segment after a hyphen
/// (`-1`) is INVALID WIT kebab-case grammar (each `-`-separated segment
/// must start with a letter, not a digit) -- `wasm-tools component wit`'s
/// pretty-printer round-trip silently accepted `world stage-v1-1` when
/// this was verified locally, but `wit-bindgen` 0.44.0's parser (the one
/// `sdk/waddle-sdk-rs` actually builds against via `wit_bindgen::
/// generate!`) correctly rejects it (`invalid character in identifier
/// '1'`), which only surfaced in CI. **Flag for whoever lands
/// moderation/scheduled-triggers/db-batch**: that design doc's own
/// `stage-v1_1` naming will hit this exact grammar error too -- use
/// `stage-next` (or another non-digit-leading-segment name), not
/// `stage-v1_1`/`stage-v1-1`.
///
/// **Package version intentionally NOT bumped** (still `waddle:bundle@
/// 1.0.0`) -- that design doc also sketches a package-version bump
/// (`@1.1.0`) alongside a frozen `@1.0.0` `world stage`, but per-item
/// semver pinning that would require (two differently-versioned
/// `interface types { ... }` declarations in one file) is not supported
/// syntax in this repo's pinned wasm-tools 1.259.0 WIT parser (verified:
/// `interface foo@1.0.0 { ... }` is a parse error). A single package
/// version with two worlds -- this file's actual approach -- is the
/// verified-safe additive mechanism; reconcile with that design doc's own
/// versioning story in whichever PR lands moderation/scheduled-triggers/
/// db-batch.
///
/// **Whoever lands moderation/scheduled-triggers/db-batch extends THIS
/// SAME `stage-next` world** (add `import moderation;`/`export
/// scheduled-stage;`/the `db` interface's `execute-batch` addition here)
/// rather than declaring a second next-version world -- WIT worlds are
/// not open/mergeable across files, so a second same-purpose world
/// definition would be a hard duplicate-world conflict, not an extension.
world stage-next {
  import context;
  import http;
  import kv;
  import db;
  import relay;
  import %flags;
  import log;
  import clock;
  import overlay;

  export process-stage;
  export action-stage;
  export streaming-lifecycle;
}

package waddle:bundle@1.0.0;

// Bundle object storage (spec docs/superpowers/specs/2026-11-06-bundle-object-storage.md).
// Own file + additive world so every FROZEN world in stage.wit/tool.wit stays untouched.
// Interface version 1.0.0; a breaking change adds `storage-v2`, never edits this one.

/// Host-mediated object storage over ONE bucket, one prefix per bundle. The guest
/// NEVER holds S3 credentials and never names a tenant/community (host-injected).
/// `owner = none` targets the caller's own prefix (auto-granted). `some(app-id)`
/// targets another bundle's prefix: needs an approved `storage_access` grant AND the
/// object must carry the tag `app-bundle:<caller>` -- an approved grant alone never
/// exposes untagged objects or objects tagged for other bundles. Capability:
/// flag `waddles.bundle-object-storage` (off -> `not-implemented`).
interface storage {
  variant error {
    not-granted,
    not-found,
    invalid(string),
    too-large(u64),
    quota-exceeded,
    rate-limited,
    backend(string),
    not-implemented,
  }

  record object-info {
    key: string,
    size: u64,
    content-type: string,
  }

  /// `tags` is honoured only when writing to the caller's OWN prefix (format
  /// `<k>:<v>`, <= 8). System tags (`waddles-*`) are host-written and refused if supplied.
  record put-options {
    content-type: string,
    tags: list<string>,
  }

  record list-page {
    objects: list<object-info>,
    next-cursor: option<string>,
  }

  put: func(owner: option<string>, key: string, body: list<u8>, opts: put-options) -> result<object-info, error>;
  get: func(owner: option<string>, key: string) -> result<tuple<object-info, list<u8>>, error>;
  head: func(owner: option<string>, key: string) -> result<object-info, error>;
  %list: func(owner: option<string>, key-prefix: string, cursor: option<string>, limit: u32) -> result<list-page, error>;
  delete: func(owner: option<string>, key: string) -> result<_, error>;
  /// Host-signed, GET-only URL for exactly one object; ttl clamped to 1..=300s.
  presign-get: func(owner: option<string>, key: string, ttl-seconds: u32) -> result<string, error>;
  /// OWNER-ONLY, audited: share one of your objects with `consumer` (adds tag
  /// `app-bundle:<consumer>`). `owner` must be none/own app id; otherwise `not-granted`.
  tag-add: func(owner: option<string>, key: string, consumer: string) -> result<_, error>;
  /// OWNER-ONLY, audited: revoke `consumer`'s visibility of one of your objects.
  tag-remove: func(owner: option<string>, key: string, consumer: string) -> result<_, error>;
}

/// `stage-next-tools` plus `storage`. Whoever extends the stage worlds with a
/// capability MUST mirror it here.
world stage-storage {
  include stage-next-tools;
  import storage;
}

# svc-presentation (Rust) -- Waddles overlay/presentation service.
#
# Named `Dockerfile.rust` (not `Dockerfile`) while the Python alpha at this
# same path (`Dockerfile`, `app.py`, ...) is still the deployed build --
# this becomes `Dockerfile` once that build is retired (X1 decommission,
# see src/lib.rs module doc). Both builds coexist in-tree during the
# transition, same precedent as core/svc_streaming (issue #287).
#
# Build (context = core/, the PARENT of this directory -- NOT this
# directory alone. svc-presentation's Cargo.toml declares same-repo path
# dependencies on ../overlay_schema (the unified overlay wire contract),
# ../overlay_auth (the VIEW/PUSH axum guards), and ../service_auth
# (overlay_auth's own dependency, also used directly by
# `overlay::push_trust::AppPushTrustSource`), ../egress_detokenizer (the
# overlay sink's `{user:<token>}` -> display-name pass, `overlay::detok`),
# and ../hub_client (egress_detokenizer's hub-api IdentityService client),
# so the build context must include core/overlay_schema, core/overlay_auth,
# core/service_auth, core/egress_detokenizer, and core/hub_client or
# `cargo build` fails closed with "unable to update ../overlay_schema" (no
# such file) -- same failure class as core/svc_action/Dockerfile.rust's
# identical comment documents for its own path dependencies.
#
# `hub_client`'s build.rs also compiles the repo-root `proto/` tree, which
# is a sibling of `core/` (this build context) and therefore supplied as a
# separately named `proto` build context -- same mechanism as
# core/svc_action/Dockerfile.rust (build-svc-action.yml's `build-contexts:
# proto=proto`). Run from the repo root:
#   docker build -f core/svc_presentation/Dockerfile.rust --build-context proto=proto \
#     -t localhost:32000/waddlebot/svc-presentation:alpha-<epoch> core

FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder

# protobuf-compiler (protoc) is required by `hub_client`'s build.rs
# (tonic-prost-build, compiling `proto/waddles/hub/internal/v1/*.proto`) --
# `egress_detokenizer` (`overlay::detok`) depends on `hub_client`. Version
# pinned like every other apt package in this repo's Dockerfiles.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        protobuf-compiler=3.21.12-3+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY svc_presentation/Cargo.toml svc_presentation/Cargo.lock ./svc_presentation/
COPY svc_presentation/src ./svc_presentation/src
COPY overlay_schema ./overlay_schema
COPY overlay_auth ./overlay_auth
COPY service_auth ./service_auth
COPY egress_detokenizer ./egress_detokenizer
COPY hub_client ./hub_client
# `hub_client`'s build.rs resolves protos at `CARGO_MANIFEST_DIR/../../
# proto` -- for `/build/hub_client`, that's `/proto` (image root, NOT under
# `/build`); supplied as the named `proto` build context, not COPY'd from
# `.` (the repo-root `proto/` is outside this Dockerfile's `core/` context).
COPY --from=proto . /proto
WORKDIR /build/svc_presentation
RUN cargo build --release --locked

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime

# `ca-certificates` for rustls (webpki/native roots) on outbound TLS
# (reqwest, sea-orm's runtime-tokio-rustls, OTLP, the JWKS fetch in
# `overlay::push_trust`). Full apt-get upgrade (not just one CVE'd package)
# clears every fixable HIGH/CRITICAL OS-package CVE the pinned
# debian:bookworm-slim digest still ships.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install --no-install-recommends -y ca-certificates=20250419~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home-dir /nonexistent \
       --shell /usr/sbin/nologin appuser

COPY --from=builder --chown=appuser:appuser /build/svc_presentation/target/release/svc-presentation /app/svc-presentation

WORKDIR /app
USER appuser

ENV MODULE_PORT=8207 \
    METRICS_PORT=9090

# Native Rust healthcheck subcommand -- never curl (rules/client.md,
# rules/general.md anti-patterns table).
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/app/svc-presentation", "--healthcheck"]

EXPOSE 8207 9090

ENTRYPOINT ["/app/svc-presentation"]

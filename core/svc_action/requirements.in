# HTTP client -- svc-action's own shared httpx.AsyncClient (app.py's
# startup(), passed to every bundle entrypoint as its http_client kwarg).
# [http2] extra (pulls in `h2`) is mandatory, not decorative -- bundles/
# discord_send_action.py and any bundle using waddle_transports' `http`
# transport's `grpc` sub_type need real HTTP/2 negotiation, which httpx
# only does when the client was constructed with http2=True.
httpx[http2]>=0.27.0,<0.28.0


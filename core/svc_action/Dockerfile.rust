# svc-action (Rust) -- Waddles ACTION pipeline stage-runner.
#
# Named `Dockerfile.rust` (not `Dockerfile`) while the Python alpha at this
# same path (`Dockerfile`, `app.py`, `runner.py`, ...) is still the deployed
# build -- mirrors `core/svc_streaming`'s coexistence pattern. This becomes
# `Dockerfile` once the Python build is retired (M6 cutover).
#
# Build (context = core/, the PARENT of this directory -- NOT this directory
# alone. svc-action's Cargo.toml declares same-repo path dependencies on
# the sibling crates `bundle-active-set` (`bundle-active-set = { path =
# "../bundle_active_set" }`, the DB-driven active-bundle loader's shared
# query/diff logic), `bundle-host-kv` (`bundle-host-kv = { path =
# "../bundle_host_kv" }`, the `kv` host capability's shared key-derivation/
# isolation/quota logic), `bundle-host-db` (`bundle-host-db = { path =
# "../bundle_host_db" }`, the `db` host capability's shared insert/get/
# update/delete logic) and `bundle-host-http` (the bundle `http` host
# capability's shared, SSRF-hardened egress guard). `bundle-host-http`
# itself now has a same-repo path dependency on `egress-assertion` (the
# signed allowlist-assertion verifier), so the build context must include
# core/bundle_active_set, core/bundle_host_kv, core/bundle_host_db,
# core/bundle_host_http, AND core/egress_assertion, or `cargo build` fails
# closed with "unable to update /bundle_active_set" (or "/bundle_host_kv" /
# "/bundle_host_db" / "/bundle_host_http" / "/egress_assertion") (no such
# file) -- same failure class as gh-425/gh-498. Run from core/:
#   docker build -f svc_action/Dockerfile.rust -t localhost:32000/waddlebot/svc-action-rust:alpha-<epoch> .
# ("svc-action-rust", not "svc-action" -- fix/helm-alpha-self-provisioning, see
# core/svc_ingest/Dockerfile.rust's identical comment.)

FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder

# cmake + a C/C++ compiler are required to build aws-lc-sys -- this crate's
# `jsonwebtoken` dependency (`crate::service_jwt`, the distribution-poll
# service-JWT minter) pulls in the `aws_lc_rs` crypto backend, same as
# `core/svc_streaming`'s Cargo.toml (see that crate's Dockerfile.rust
# comment for the RUSTSEC-2023-0071 rationale). rustls itself still
# resolves to `ring` here (unaffected), but `aws-lc-sys` now needs `cmake`
# regardless.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        cmake=3.25.1-1 build-essential=12.9 ca-certificates=20250419~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY svc_action/Cargo.toml svc_action/Cargo.lock ./svc_action/
COPY svc_action/src ./svc_action/src
COPY bundle_active_set ./bundle_active_set
COPY bundle_host_kv ./bundle_host_kv
COPY bundle_host_db ./bundle_host_db
COPY bundle_host_http ./bundle_host_http
COPY egress_assertion ./egress_assertion
WORKDIR /build/svc_action
RUN cargo build --release --locked

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime

# `ca-certificates` for rustls (webpki/native roots) on outbound TLS
# (reqwest healthcheck client, sea-orm's runtime-tokio-rustls, OTLP).
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates=20250419~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home-dir /nonexistent \
       --shell /usr/sbin/nologin appuser

COPY --from=builder --chown=appuser:appuser /build/svc_action/target/release/svc-action /app/svc-action

WORKDIR /app
USER appuser

ENV MODULE_PORT=8202 \
    METRICS_PORT=9090

# Native Rust healthcheck subcommand -- never curl (rules/client.md,
# rules/general.md anti-patterns table).
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/app/svc-action", "--healthcheck"]

EXPOSE 8202 9090

ENTRYPOINT ["/app/svc-action"]

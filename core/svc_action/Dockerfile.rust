# svc-action (Rust) -- Waddles ACTION pipeline stage-runner.
#
# Named `Dockerfile.rust` (not `Dockerfile`) while the Python alpha at this
# same path (`Dockerfile`, `app.py`, `runner.py`, ...) is still the deployed
# build -- mirrors `core/svc_streaming`'s coexistence pattern. This becomes
# `Dockerfile` once the Python build is retired (M6 cutover).
#
# Build (context = this directory, not the repo root -- no shared libs to
# pull in for this Rust crate):
#   docker build -f Dockerfile.rust -t localhost:32000/waddlebot/svc-action:alpha-<epoch> .

FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder

# cmake + a C/C++ compiler are required to build aws-lc-sys -- this crate's
# `jsonwebtoken` dependency (`crate::service_jwt`, the distribution-poll
# service-JWT minter) pulls in the `aws_lc_rs` crypto backend, same as
# `core/svc_streaming`'s Cargo.toml (see that crate's Dockerfile.rust
# comment for the RUSTSEC-2023-0071 rationale). rustls itself still
# resolves to `ring` here (unaffected), but `aws-lc-sys` now needs `cmake`
# regardless.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        cmake=3.25.1-1 build-essential=12.9 ca-certificates=20250419~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

# `ca-certificates` for rustls (webpki/native roots) on outbound TLS
# (reqwest healthcheck client, sea-orm's runtime-tokio-rustls, OTLP).
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates=20250419~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home-dir /nonexistent \
       --shell /usr/sbin/nologin appuser

COPY --from=builder --chown=appuser:appuser /build/target/release/svc-action /app/svc-action

WORKDIR /app
USER appuser

ENV MODULE_PORT=8202 \
    METRICS_PORT=9090

# Native Rust healthcheck subcommand -- never curl (rules/client.md,
# rules/general.md anti-patterns table).
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/app/svc-action", "--healthcheck"]

EXPOSE 8202 9090

ENTRYPOINT ["/app/svc-action"]

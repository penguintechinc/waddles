# bundle-executor (Rust) -- Waddles credential-less WASM bundle sandbox host.
#
# Stateless executor: holds a wasmtime engine, instantiates a bundle's WASI 0.2
# component, services every WIT host import over the host-API wire protocol to
# its stage, and natively denies wasi:sockets. No secrets, no credentials, no
# network egress policy needed -- the security argument is dependency minimalism
# (spec SS4.5/SS14.6 test 16 asserts NO redis, sea-orm, sqlx, reqwest in the
# dependency graph).
#
# Build (context = repo root; includes wit/ files):
#   docker build -f core/bundle_executor/Dockerfile.rust -t localhost:32000/waddlebot/svc-bundles-executor:alpha-<epoch> .

FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder

# A C compiler -- required to build `ring` (rustls's crypto provider;
# confirmed via `cargo deny check`'s dependency graph that this crate depends
# on `ring`, not `aws-lc-sys`).
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential=12.9 ca-certificates=20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
COPY core/bundle_executor core/bundle_executor
COPY wit wit
WORKDIR /repo/core/bundle_executor
# BuildKit cache mounts (bounded, explicit ids; none of this reaches the image layers):
#  - cargo registry/git: downloaded crates, shared by every Rust image on the same BuildKit pod.
#    Content is checksum-verified against Cargo.lock, so it cannot change build output.
#  - target dir: ONE per image (id waddles-target-<image>) so a source change recompiles only
#    the changed first-party crates, not every third-party dependency. Lives in the BuildKit
#    pod's local store, which the pod's GC policy caps (exec.cachemount kept 6h, 40GB total).
#    The binary is copied out inside the same RUN because cache mounts are not in the layer.
# `--locked` stays: a stale/poisoned cache can never change the resolved dependency set.
RUN --mount=type=cache,id=waddles-cargo-registry,target=/usr/local/cargo/registry,sharing=shared \
    --mount=type=cache,id=waddles-cargo-git,target=/usr/local/cargo/git,sharing=shared \
    --mount=type=cache,id=waddles-target-svc-bundles-executor,target=/repo/core/bundle_executor/target,sharing=locked \
    cargo build --release --locked \
    && install -D -m 0755 target/release/bundle-executor /out/bundle-executor

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime

# `ca-certificates` for rustls (webpki/native roots) on outbound TLS if needed.
# Wasmtime is statically linked; no libc-specific runtime deps beyond the
# system libc (inherited from debian-slim base).
# Full apt-get upgrade (not just libpcre2-8-0) clears every fixable
# HIGH/CRITICAL OS-package CVE the pinned debian:bookworm-slim digest
# still ships (perl/perl-base, libcap, libgnutls, libpcre2-8-0, ...).
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install --no-install-recommends -y \
        ca-certificates=20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home-dir /nonexistent \
       --shell /usr/sbin/nologin appuser

COPY --from=builder --chown=appuser:appuser /out/bundle-executor /app/bundle-executor

WORKDIR /app
USER appuser

ENV EXECUTOR_PORT=8203

# Native Rust healthcheck subcommand -- the executor supports `--healthcheck`
# which exits 0 iff the main server loop is responsive.
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/app/bundle-executor", "--healthcheck"]

EXPOSE 8203

ENTRYPOINT ["/app/bundle-executor"]

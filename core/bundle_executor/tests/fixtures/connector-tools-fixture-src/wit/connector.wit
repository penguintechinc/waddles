// Test-fixture-only trimmed copy of `wit/waddle-connector/connector.wit` for the
// P6a T4 `connector-tools` fixture. `types`/`receiver`/`sender` are byte-for-byte
// identical to the normative file; the reused `waddle:bundle` http/log/clock/flags
// and `identity` imports are omitted (this fixture calls none; a component
// importing fewer functions links fine against the full-world `Linker`). The
// world adds the P3b tool surface exactly as the normative `connector-tools`
// world does; `tool`/`tool-provider` resolve from `deps/waddle-bundle/tool.wit`.
package waddle:connector@1.0.0;

interface types {
  record connection-ctx {
    platform: string,
    source-id: string,
    connection-id: string,
    session-token: option<string>,
  }

  record raw-frame {
    ctx: connection-ctx,
    bytes: list<u8>,
    received-at: string,
  }

  record normalized-event {
    platform: string,
    event-type: string,
    actor: option<string>,
    payload-json: string,
    occurred-at: string,
  }

  record handshake-payload {
    bytes: list<u8>,
    secret-refs: list<tuple<string, string>>,
  }

  variant frame-error { unsupported(string), malformed(string), backend(string) }
}

interface identity {
  variant identity-key {
    uuid(string),
    platform-identity(tuple<string, string>),
  }

  record identity-record {
    uuid: string,
    linked: bool,
    handle: option<string>,
    display-name: option<string>,
  }

  variant error { denied(string), not-found, rate-limited(u32), backend(string) }

  lookup: func(key: identity-key) -> result<identity-record, error>;
}

interface receiver {
  use types.{connection-ctx, raw-frame, normalized-event, handshake-payload, frame-error};

  on-connect: func(ctx: connection-ctx) -> result<handshake-payload, frame-error>;
  on-frame: func(frame: raw-frame) -> result<list<normalized-event>, frame-error>;
  on-heartbeat-due: func(ctx: connection-ctx) -> result<option<list<u8>>, frame-error>;
  on-disconnect: func(ctx: connection-ctx, reason: string);
}

interface sender {
  use types.{frame-error};

  record header { name: string, value: string }

  record action {
    kind: string,
    target-source-id: string,
    payload-json: string,
  }

  record http-request-tpl {
    method: string,
    url: string,
    headers: list<header>,
    body: option<list<u8>>,
    secret-refs: list<tuple<string, string>>,
  }

  build-request: func(action: action) -> result<http-request-tpl, frame-error>;
}

world connector-tools {
  import waddle:bundle/tool@1.0.0;

  export receiver;
  export sender;
  export waddle:bundle/tool-provider@1.0.0;
}

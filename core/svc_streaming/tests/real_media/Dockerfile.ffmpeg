# Real-ffmpeg toolchain for tests/e2e_real_media.rs (feature `real-media-e2e`).
# Same base digest and exact ffmpeg build as the runtime-base stage of
# ../../Dockerfile.rust (the cpu image), so the test proves the media path on the
# ffmpeg that actually ships. Built by tests/real_media/run.sh; never pushed.
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg=7:5.1.9-0+deb12u1 \
    && rm -rf /var/lib/apt/lists/*
USER 65534:65534

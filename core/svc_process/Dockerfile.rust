# syntax=docker/dockerfile:1.7
# svc-process (Rust) -- Waddles process-stage data-plane service.
#
# Named `Dockerfile.rust` (not `Dockerfile`) while the Python control
# plane + stage-runner at this same path (`Dockerfile`, `app.py`, ...) is
# still the deployed build -- this becomes `Dockerfile` at M6 cut-over,
# same pattern as `core/svc_streaming/Dockerfile.rust`.
#
# M4 skeleton: builds and serves /health, /healthz, /metrics only. No
# executor, no bundle host, no Postgres/Valkey connection -- see
# src/lib.rs `// TODO(M4)` markers.
#
# Build (context = core/, the PARENT of this directory -- NOT this directory
# alone. svc-process's Cargo.toml declares same-repo path dependencies on
# the sibling crates `bundle-active-set` (`bundle-active-set = { path =
# "../bundle_active_set" }`, the DB-driven active-bundle loader's shared
# query/diff logic), `bundle-host-kv` (`bundle-host-kv = { path =
# "../bundle_host_kv" }`, the `kv` host capability's shared key-derivation/
# isolation/quota logic), `bundle-host-db` (`bundle-host-db = { path =
# "../bundle_host_db" }`, the `db` host capability's shared insert/get/
# update/delete logic) and `bundle-host-http` (the bundle `http` host
# capability's shared, SSRF-hardened egress guard). `bundle-host-http`
# itself now has a same-repo path dependency on `egress-assertion` (the
# signed allowlist-assertion verifier), so the build context must include
# core/bundle_active_set, core/bundle_host_kv, core/bundle_host_db,
# core/bundle_host_http, AND core/egress_assertion, or `cargo build` fails
# closed with "unable to update /bundle_active_set" (or "/bundle_host_kv" /
# "/bundle_host_db" / "/bundle_host_http" / "/egress_assertion") (no such
# file) -- same failure class as gh-425/gh-498. `hub_client` (PII
# tokenization pass's `IdentityService.MintEphemeralPseudonyms` client) is
# the same pattern: core/hub_client must also be in the build context, or
# the identical "no such file" failure. Run from core/:
#   docker build -f svc_process/Dockerfile.rust -t localhost:32000/waddlebot/svc-process-rust:alpha-<epoch> .
# ("svc-process-rust", not "svc-process" -- fix/helm-alpha-self-provisioning, see
# core/svc_ingest/Dockerfile.rust's identical comment.)

FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder

# protobuf-compiler (protoc) is required by `hub_client`'s build.rs
# (tonic-prost-build, compiling `proto/waddles/hub/internal/v1/*.proto`).
RUN apt-get update \
    && apt-get install --no-install-recommends -y protobuf-compiler=3.21.12-3+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY svc_process/Cargo.toml svc_process/Cargo.lock ./svc_process/
COPY svc_process/src ./svc_process/src
COPY bundle_active_set ./bundle_active_set
COPY bundle_host_kv ./bundle_host_kv
COPY bundle_host_db ./bundle_host_db
COPY bundle_host_http ./bundle_host_http
COPY egress_assertion ./egress_assertion
COPY hub_client ./hub_client
COPY service_auth ./service_auth
# `hub_client`'s build.rs resolves protos at `CARGO_MANIFEST_DIR/../../
# proto` -- for `/build/hub_client`, that's `/proto` (image root, NOT
# under `/build`). The repo-root `proto/` tree is a sibling of `core/`
# (this Dockerfile's build context), so it's supplied as the separately
# named `proto` build context (see build-svc-process.yml's `build-contexts`)
# rather than COPY'd from `.`.
COPY --from=proto . /proto
WORKDIR /build/svc_process
RUN cargo build --release --locked

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime

# `ca-certificates` for rustls (webpki/native roots) on outbound TLS
# (reqwest, sea-orm's runtime-tokio-rustls, OTLP).
# CVE-2026-103111 (libpcre2): upgrade to 10.42-1+deb12u2 from security updates.
RUN apt-get update \
    && apt-get install --no-install-recommends -y --only-upgrade libpcre2-8-0 \
    && apt-get install --no-install-recommends -y ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home-dir /nonexistent \
       --shell /usr/sbin/nologin appuser

COPY --from=builder --chown=appuser:appuser /build/svc_process/target/release/svc-process /app/svc-process

WORKDIR /app
USER appuser

ENV MODULE_PORT=8201 \
    METRICS_PORT=9090

# Native Rust healthcheck subcommand -- never curl (rules/client.md,
# rules/general.md anti-patterns table).
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/app/svc-process", "--healthcheck"]

EXPOSE 8201 9090

ENTRYPOINT ["/app/svc-process"]

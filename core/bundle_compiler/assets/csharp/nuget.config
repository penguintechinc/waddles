<?xml version="1.0" encoding="utf-8"?>
<!--
  Canonical NuGet feed list every C# bundle build uses. `CSharpBuilder`
  writes this into the build context unconditionally, overwriting whatever
  (if anything) the bundle source itself provided (README "What a
  CSharpBuilder would need" item 5: enforce the feed, never leave it to a
  bundle author or let a malicious bundle redirect it). Identical content
  to `bundles/csharp/csping/nuget.config`; see that file's header comment
  for why `dotnet-experimental` is required (NativeAOT-LLVM's
  `Microsoft.DotNet.ILCompiler.LLVM` package lives only on that feed, never
  nuget.org).

  NOTE: an XML comment body may never contain two consecutive hyphens, so
  this comment (unlike this repo's Rust/Markdown prose) uses a period or a
  single hyphen instead of the usual double-hyphen dash: getting this wrong
  is a real, blocking `dotnet build` failure this file itself would trip.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="dotnet-experimental" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

# svc-ingest -- Dependencies
# Real stage-runner: Quart control plane + background poll/normalize/enqueue
# loop + supervised socket receivers (8-container decision -- folded in
# from the standalone svc-gateway skeleton). flask_core (libs/flask_core)
# is installed as a separate package step (Dockerfile) and brings in
# redis/httpx transitively via its own requirements.in -- pinned here too
# for explicitness on direct imports.

# Core Framework
quart>=0.19.0
hypercorn>=0.16.0

# HTTP client (distribution API poll)
httpx>=0.27.0,<0.28.0

# Valkey/Redis (LPUSH/RPUSH per-bundle isolation keys, socket_lease.py's
# SET NX PX / EVAL compare-and-expire ops)
redis>=5.0.1
hiredis>=2.3.2

# Discord gateway receiver -- real py-cord connection, matches
# trigger/receiver/discord_module/requirements.txt's own pin.
py-cord>=2.4.1

# Slack Socket Mode gateway receiver -- real slack_sdk connection
# (slack_sdk.socket_mode.aiohttp.SocketModeClient + AsyncWebClient),
# deliberately NOT slack_bolt (trigger/receiver/slack_module's own
# dependency -- see receivers/slack_socket.py's own docstring for why).
slack-sdk>=3.44.1

# Twitch IRC gateway receiver -- no direct dependency here; the wire
# protocol is libs/waddle_transports' own IrcTransport (raw asyncio TCP/
# TLS, stdlib only), installed as a separate package step (Dockerfile),
# same pattern as flask_core above.

# Identity-field envelope encryption (identity_crypto.py) -- AES-256-GCM
# via `cryptography`'s AEAD primitives (rustls-backed OpenSSL alternative
# already used elsewhere in this org, security.md); prometheus_client for
# the encryption-outcome counter, mirroring flask_core.custom_metrics'
# existing direct dependency.
cryptography>=42.0.0
prometheus_client>=0.20.0


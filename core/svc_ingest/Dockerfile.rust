# svc-ingest (Rust) -- Waddles chat/event data-plane ingest service.
#
# Named `Dockerfile.rust` (not `Dockerfile`) while the Python alpha at this
# same path (`Dockerfile`, `app.py`, ...) is still the deployed build --
# this becomes `Dockerfile` once that build is retired in M6 (see
# core/svc_streaming/Dockerfile.rust for the identical pattern already in
# use there).
#
# Build (context = this directory, not the repo root -- no shared libs to
# pull in for a Rust crate):
#   docker build -f Dockerfile.rust -t localhost:32000/waddles/svc-ingest:alpha-<epoch> .
#
# No SeaORM/database, so unlike svc_streaming's builder stage this one
# needs no cmake/build-essential -- the M5 skeleton's `reqwest` (rustls-tls)
# resolves to the pure-Rust `ring` crypto backend, which only needs the C
# compiler already present in `rust:*-bookworm` base images.

FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

# ca-certificates for rustls (webpki/native roots) on outbound TLS
# (reqwest, OTLP) -- required once the hub-api distribution poll and
# connector work land; harmless to have now.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates=20250419~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home-dir /nonexistent \
       --shell /usr/sbin/nologin appuser

COPY --from=builder --chown=appuser:appuser /build/target/release/svc-ingest /app/svc-ingest

WORKDIR /app
USER appuser

ENV MODULE_PORT=8200 \
    METRICS_PORT=9090

# Native Rust healthcheck subcommand -- never curl (rules/client.md,
# rules/general.md anti-patterns table).
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/app/svc-ingest", "--healthcheck"]

EXPOSE 8200 9090

ENTRYPOINT ["/app/svc-ingest"]

# svc-ingest (Rust) -- Waddles chat/event data-plane ingest service.
#
# Named `Dockerfile.rust` (not `Dockerfile`) while the Python alpha at this
# same path (`Dockerfile`, `app.py`, ...) is still the deployed build --
# this becomes `Dockerfile` once that build is retired in M6 (see
# core/svc_streaming/Dockerfile.rust for the identical pattern already in
# use there).
#
# Build (context = `core/`, the parent of this directory, because this crate
# path-depends on the sibling `service_auth` crate for its dataplane scope-resolver
# machine-JWT client -- same layout as core/svc_process/Dockerfile.rust):
#   docker build -f svc_ingest/Dockerfile.rust -t localhost:32000/waddlebot/svc-ingest-rust:alpha-<epoch> core/
# ("svc-ingest-rust", not "svc-ingest" -- fix/helm-alpha-self-provisioning gives the Rust
# build its own repository so it never collides with the Python Deployment's tag while
# both coexist in alpha; the Helm chart's rustDataPlane.svcIngest.imageRepository default
# matches this exactly.)
#
# No SeaORM/database, so unlike svc_streaming's builder stage this one
# needs no cmake/build-essential -- the M5 skeleton's `reqwest` (rustls-tls)
# resolves to the pure-Rust `ring` crypto backend, which only needs the C
# compiler already present in `rust:*-bookworm` base images.

FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder

WORKDIR /build
COPY svc_ingest/Cargo.toml svc_ingest/Cargo.lock ./svc_ingest/
COPY svc_ingest/src ./svc_ingest/src
COPY service_auth ./service_auth
WORKDIR /build/svc_ingest
RUN cargo build --release --locked

FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS runtime

# ca-certificates for rustls (webpki/native roots) on outbound TLS
# (reqwest, OTLP) -- required once the hub-api distribution poll and
# connector work land; harmless to have now.
# Full apt-get upgrade (not just libpcre2-8-0) clears every fixable
# HIGH/CRITICAL OS-package CVE the pinned debian:bookworm-slim digest
# still ships (perl/perl-base, libcap, libgnutls, libpcre2-8-0, ...).
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install --no-install-recommends -y \
        ca-certificates=20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 appuser \
    && useradd --system --uid 10001 --gid appuser --home-dir /nonexistent \
       --shell /usr/sbin/nologin appuser

COPY --from=builder --chown=appuser:appuser /build/svc_ingest/target/release/svc-ingest /app/svc-ingest

WORKDIR /app
USER appuser

ENV MODULE_PORT=8200 \
    METRICS_PORT=9090

# Native Rust healthcheck subcommand -- never curl (rules/client.md,
# rules/general.md anti-patterns table).
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/app/svc-ingest", "--healthcheck"]

EXPOSE 8200 9090

ENTRYPOINT ["/app/svc-ingest"]

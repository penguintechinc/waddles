# Database Configuration
DATABASE_URL=postgresql://waddlebot:password@localhost:5432/waddlebot
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# HTTP Server Configuration
MODULE_HOST=0.0.0.0
MODULE_PORT=8090
MODULE_VERSION=1.0.0

# gRPC Configuration
GRPC_HOST=0.0.0.0
GRPC_PORT=50060

# MarchProxy gRPC Configuration
MARCHPROXY_GRPC_HOST=localhost
MARCHPROXY_GRPC_PORT=50050

# Module Security
MODULE_SECRET_KEY=change-me-in-production

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-change-in-production

# S3-compatible object storage (SeaweedFS in dev/beta, real S3 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=video-proxy
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# License Server Configuration
LICENSE_SERVER_URL=https://license.penguintech.io
LICENSE_KEY=
RELEASE_MODE=false

# Feature Limits
FREE_MAX_DESTINATIONS=3
FREE_MAX_2K_DESTINATIONS=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Timeout Configuration
GRPC_TIMEOUT=30
HTTP_TIMEOUT=30

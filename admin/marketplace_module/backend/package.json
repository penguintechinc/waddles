{
  "name": "waddlebot-marketplace-backend",
  "version": "1.0.0",
  "description": "WaddleBot Marketplace Backend with Payment Integration",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "waddlebot",
    "marketplace",
    "payments",
    "stripe",
    "paypal"
  ],
  "author": "WaddleBot Team",
  "license": "MIT",
  "dependencies": {
    "@paypal/checkout-server-sdk": "1.0.3",
    "stripe": "14.25.0",
    "express": "4.22.2",
    "dotenv": "16.6.1",
    "cors": "2.8.6",
    "helmet": "7.2.0",
    "express-rate-limit": "7.5.1",
    "morgan": "1.11.0",
    "express-validator": "7.3.2",
    "pg": "8.22.0",
    "pg-hstore": "2.3.4",
    "cookie-parser": "1.4.7",
    "jsonwebtoken": "9.0.3",
    "redis": "4.7.1",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "nodemon": "3.1.14",
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "eslint": "9.39.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}

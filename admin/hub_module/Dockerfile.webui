# syntax=docker/dockerfile:1.7
# Dockerfile for WaddleBot Hub WebUI
# Builds the React/Vite frontend and serves it via a minimal Express
# static-file + API-proxy server -- never nginx (house convention).

# Stage 1: Build frontend
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0 AS frontend-build

WORKDIR /build/admin/hub_module/frontend

COPY admin/hub_module/frontend/package*.json ./

# @penguintechinc packages are published to npmjs.com, so no registry auth
# is needed and no token ever enters the build.
RUN npm ci --ignore-scripts && npm rebuild esbuild

COPY admin/hub_module/frontend/ ./

RUN npm run build

# Stage 2: Express runtime -- static serving + /api proxy only
FROM node:20-bookworm-slim@sha256:2cf067cfed83d5ea958367df9f966191a942351a2df77d6f0193e162b5febfc0

WORKDIR /app

# Upgrade all base-image OS packages to the latest Debian bookworm security
# point release before installing anything -- clears HIGH/CRITICAL OS-package
# CVEs (libpcre2, perl/perl-base, libcap, libgnutls, etc.) that the pinned
# node:20-bookworm-slim digest still ships; the pinned digest above is bumped
# on every touch, this closes the gap until the next rebuild lands upstream.
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends dumb-init curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -s /bin/bash nodejs

# Install the exact locked server dependency graph (express + http-proxy-middleware)
COPY admin/hub_module/webui-server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts

# Copy the proxy/static server and the built frontend assets
COPY --chown=nodejs:nodejs admin/hub_module/webui-server/server.js ./server.js
COPY --chown=nodejs:nodejs --from=frontend-build /build/admin/hub_module/frontend/dist ./dist

ENV NODE_ENV=production
ENV PORT=8080

USER nodejs

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]

# syntax=docker/dockerfile:1.7
# Dockerfile for WaddleBot Hub WebUI
# Builds the React/Vite frontend and serves it via a minimal Express
# static-file + API-proxy server -- never nginx (house convention).

# node:20 reached upstream EOL 2026-04-30; bumped to node:24 (same interim pin as
# admin/hub_module/Dockerfile -- org target node:26 not yet adopted here).
# Stage 1: Build frontend
FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS frontend-build

WORKDIR /build/admin/hub_module/frontend

COPY admin/hub_module/frontend/package*.json ./

# @penguintechinc packages are published to npmjs.com, so no registry auth
# is needed and no token ever enters the build.
RUN npm ci --ignore-scripts && npm rebuild esbuild

COPY admin/hub_module/frontend/ ./

RUN npm run build

# Stage 2: Express runtime -- static serving + /api proxy only
FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

WORKDIR /app

# OS-package CVE fix: exact pin of the Debian bookworm security release for
# perl-base (trivy HIGH/CRITICAL gate). Never a blanket `apt-get upgrade`
# (devops-containers.md); drop the pin once the base digest is rebuilt upstream.
RUN apt-get update && apt-get install -y --no-install-recommends \
    perl-base=5.36.0-7+deb12u4 dumb-init curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -s /bin/bash nodejs

# Install the exact locked server dependency graph (express + http-proxy-middleware)
COPY admin/hub_module/webui-server/package*.json ./
# Install the locked server dependencies, then remove the base image's bundled global npm.
# The runtime entrypoint is `node server.js` -- npm/npx/corepack are never invoked after
# this point, and npm's vendored node_modules (tar, brace-expansion, sigstore, undici, ...)
# carry independent CVEs unrelated to this lockfile, so they are removed in the same layer.
RUN npm ci --omit=dev --ignore-scripts \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

# Copy the proxy/static server and the built frontend assets
COPY --chown=nodejs:nodejs admin/hub_module/webui-server/server.js ./server.js
COPY --chown=nodejs:nodejs --from=frontend-build /build/admin/hub_module/frontend/dist ./dist

ENV NODE_ENV=production
ENV PORT=8080

USER nodejs

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]

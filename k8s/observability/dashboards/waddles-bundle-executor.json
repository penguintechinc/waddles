          "expr": "1 - sum(rate(waddles_bundle_kv_op_duration_seconds_bucket{le=\"5\"}[$rate])) / sum(rate(waddles_bundle_kv_op_duration_seconds_count[$rate]))",
          "legendFormat": "slow ops",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {

# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Python test & cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/
# Chart unit/render tests and documentation (not needed in cluster release secrets)
tests/
docs/
README.md
PIPELINE_MAPPING.md
charts/*/README.md

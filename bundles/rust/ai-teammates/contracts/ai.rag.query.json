{
  "tool": "ai.rag.query",
  "target": "waddles.core.service.ai",
  "access": "read",
  "request": {
    "type": "object",
    "required": [
      "query",
      "top_k"
    ],
    "additionalProperties": false,
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 400
      },
      "top_k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "collection": {
        "type": "string",
        "maxLength": 100
      }
    }
  },
  "response": {
    "type": "object",
    "required": [
      "matches"
    ],
    "properties": {
      "matches": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "text",
            "score"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}

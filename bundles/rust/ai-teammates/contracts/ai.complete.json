{
  "tool": "ai.complete",
  "target": "waddles.core.service.ai",
  "access": "read",
  "request": {
    "type": "object",
    "required": [
      "system",
      "prompt",
      "max_tokens",
      "temperature",
      "purpose"
    ],
    "additionalProperties": false,
    "properties": {
      "system": {
        "type": "string",
        "maxLength": 4000
      },
      "prompt": {
        "type": "string",
        "maxLength": 8000
      },
      "max_tokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 512
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2
      },
      "purpose": {
        "type": "string",
        "enum": [
          "researcher",
          "onboard",
          "receptionist",
          "producer"
        ]
      }
    }
  },
  "response": {
    "type": "object",
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string"
      },
      "model": {
        "type": "string"
      }
    }
  }
}

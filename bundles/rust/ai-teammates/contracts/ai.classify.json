{
  "tool": "ai.classify",
  "target": "waddles.core.service.ai",
  "access": "read",
  "source": "bundles/contracts/ai-tools.v1.json (PR #1120)",
  "request": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "minItems": 2,
        "maxItems": 20,
        "uniqueItems": true
      },
      "instructions": {
        "type": "string",
        "maxLength": 800
      }
    },
    "required": [
      "text",
      "labels"
    ],
    "additionalProperties": false
  },
  "response": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string"
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "reason": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [
      "label",
      "confidence",
      "reason"
    ]
  }
}

{
  "name": "ai.classify",
  "access": "read",
  "risk": "normal",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {"type": "string", "minLength": 1, "maxLength": 2000},
      "labels": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "maxLength": 40},
        "minItems": 2,
        "maxItems": 20,
        "uniqueItems": true
      },
      "instructions": {"type": "string", "maxLength": 800}
    },
    "required": ["text", "labels"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "label": {"type": "string"},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "reason": {"type": "string", "maxLength": 200}
    },
    "required": ["label", "confidence", "reason"]
  },
  "examples_valid": [
    {"text": "great song", "labels": ["allow", "deny"]},
    {"text": "t", "labels": ["a", "b", "c"], "instructions": "Prefer deny when unsure."}
  ],
  "examples_invalid": [
    {"text": "x"},
    {"text": "x", "labels": ["only"]},
    {"text": "x", "labels": ["a", "a"]},
    {"text": "x", "labels": ["a", "b<"]},
    {"labels": ["a", "b"]},
    {"text": "x", "labels": ["a", "b"], "extra": 1}
  ]
}

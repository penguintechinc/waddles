{
  "name": "ai.complete",
  "access": "read",
  "risk": "normal",
  "input_schema": {
    "type": "object",
    "properties": {
      "prompt": {"type": "string", "minLength": 1, "maxLength": 3500},
      "system": {"type": "string", "maxLength": 1200},
      "max_tokens": {"type": "integer", "minimum": 1, "maximum": 512},
      "temperature": {"type": "number", "minimum": 0, "maximum": 2}
    },
    "required": ["prompt"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {"text": {"type": "string", "maxLength": 2000}},
    "required": ["text"]
  },
  "examples_valid": [
    {"prompt": "Say hi"},
    {"prompt": "Summarize", "system": "Be brief.", "max_tokens": 64, "temperature": 0.2}
  ],
  "examples_invalid": [
    {},
    {"prompt": ""},
    {"prompt": "x", "max_tokens": 513},
    {"prompt": "x", "max_tokens": 0},
    {"prompt": "x", "temperature": 2.5},
    {"prompt": "x", "model": "gpt"},
    {"prompt": 5}
  ]
}

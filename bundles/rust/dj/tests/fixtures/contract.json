{
  "_comment": "Contract of every tool the dj bundle CONSUMES (catalog spec sections 3-5). Providers/ai/economy bundles are built in parallel; a mismatch here must fail loudly in both repos' tests.",
  "tools": {
    "music.search": {
      "args": {"type":"object","required":["query","limit"],"additionalProperties":false,
        "properties":{"query":{"type":"string","maxLength":200},"limit":{"type":"integer","minimum":1,"maximum":10}}},
      "result": {"type":"object","required":["tracks"],"properties":{"tracks":{"type":"array","maxItems":10,"items":{"$ref":"track"}}}}
    },
    "music.track": {
      "args": {"type":"object","required":["ref"],"additionalProperties":false,"properties":{"ref":{"type":"string","maxLength":300}}},
      "result": {"type":"object","required":["track"],"properties":{"track":{"$ref":"track_or_null"}}}
    },
    "music.playlist.get": {
      "args": {"type":"object","required":["ref","limit"],"additionalProperties":false,"properties":{"ref":{"type":"string","maxLength":300},"limit":{"type":"integer","minimum":1,"maximum":200}}},
      "result": {"type":"object","required":["tracks"],"properties":{"tracks":{"type":"array","maxItems":200,"items":{"$ref":"track"}},"title":{"type":"string"}}}
    },
    "music.playback": {
      "args": {"type":"object","required":["action","ref"],"additionalProperties":false,"properties":{"action":{"enum":["play"]},"ref":{"type":"string","maxLength":128}}},
      "result": {"type":"object","properties":{"capability":{"type":"object"}}}
    },
    "ai.complete": {
      "args": {"type":"object","required":["prompt","json","max_tokens"],"additionalProperties":false,"properties":{"prompt":{"type":"string","maxLength":4000},"json":{"type":"boolean"},"max_tokens":{"type":"integer","minimum":1,"maximum":512}}},
      "result": {"type":"object","required":["text"],"properties":{"text":{"type":"string"}}}
    },
    "ai.classify": {
      "args": {"type":"object","required":["text","labels","context"],"additionalProperties":false,"properties":{"text":{"type":"string","maxLength":300},"labels":{"type":"array","items":{"type":"string"},"minItems":2,"maxItems":8},"context":{"type":"string","maxLength":120}}},
      "result": {"type":"object","required":["label","confidence"],"properties":{"label":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1}}}
    },
    "economy.adjust_balance": {
      "args": {"type":"object","required":["user","delta"],"additionalProperties":false,"properties":{"user":{"type":"string","maxLength":36},"delta":{"type":"integer"}}},
      "result": {"type":"object"}
    }
  },
  "defs": {
    "track": {"type":"object","required":["provider","id","title","artist","duration_s"],"properties":{
      "provider":{"enum":["youtube","spotify","soundcloud"]},"id":{"type":"string","maxLength":128},"title":{"type":"string"},
      "artist":{"type":"string"},"channel_id":{"type":["string","null"]},"duration_s":{"type":"integer","minimum":0},
      "explicit":{"type":"boolean"},"url":{"type":["string","null"]},"license":{"type":["string","null"]}}},
    "track_or_null": {"type":["object","null"]}
  }
}

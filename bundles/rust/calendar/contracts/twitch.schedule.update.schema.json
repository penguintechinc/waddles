{
  "tool": "twitch.schedule.update",
  "input_schema": {
    "type": "object",
    "properties": {
      "segment_id": {
        "type": "string",
        "minLength": 1
      },
      "start_time": {
        "type": "string"
      },
      "timezone": {
        "type": "string",
        "minLength": 1
      },
      "duration": {
        "type": "integer",
        "minimum": 30,
        "maximum": 1380
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "is_recurring": {
        "type": "boolean"
      }
    },
    "required": [
      "segment_id",
      "start_time",
      "timezone",
      "duration",
      "title",
      "is_recurring"
    ],
    "additionalProperties": false
  }
}

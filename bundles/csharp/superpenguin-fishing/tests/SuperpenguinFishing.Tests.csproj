<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit tests for the `superpenguin-fishing` bundle's business logic, run on the normal host CLR. Same approach as
    `bundles/csharp/superpenguin-first/tests`: the bundle's own pure-logic sources are linked (real source, not copies) while the
    wit-bindgen-dependent files (`WaddleHostAdapter.cs`, `*ExportsImpl.cs`) are excluded, because they only compile inside the
    componentize-dotnet build. The compiled component is covered by `scripts/test-superpenguin-ports-e2e.sh`.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>WaddleBundleSuperpenguinFishing.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../sdk/waddle-sdk-cs/waddle-sdk-cs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../FishingModels.cs" Link="FishingModels.cs" />
    <Compile Include="../FishingCatalog.cs" Link="FishingCatalog.cs" />
    <Compile Include="../FishingCalculations.cs" Link="FishingCalculations.cs" />
    <Compile Include="../FishingEngine.cs" Link="FishingEngine.cs" />
    <Compile Include="../FishingTournament.cs" Link="FishingTournament.cs" />
    <Compile Include="../FishingStore.cs" Link="FishingStore.cs" />
    <Compile Include="../FishingLogic.cs" Link="FishingLogic.cs" />
    <Compile Include="../FishingDispatch.cs" Link="FishingDispatch.cs" />
    <Compile Include="../FishingJson.cs" Link="FishingJson.cs" />
    <Compile Include="../ReplayGuard.cs" Link="ReplayGuard.cs" />
    <Compile Include="../../../../sdk/waddle-sdk-cs/tests/Fakes.cs" Link="SdkFakes.cs" />
    <Compile Include="../../../../sdk/waddle-sdk-cs/tests/FakesNext.cs" Link="SdkFakesNext.cs" />
  </ItemGroup>

</Project>

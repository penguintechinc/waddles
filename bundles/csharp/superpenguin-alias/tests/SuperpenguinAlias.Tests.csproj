<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit tests for the `superpenguin-alias` bundle's business logic
    (`AliasLogic`/`AliasDispatch`), run on the normal host CLR - NOT a
    ProjectReference to `../superpenguin-alias.csproj`, which pins
    `RuntimeIdentifier=wasi-wasm`/`SelfContained=true` for its
    componentize-dotnet build and cannot be restored or executed as a normal
    `dotnet test` host target. Instead this project links the bundle's own
    pure-logic source files directly (`<Compile Include="../AliasLogic.cs" />`)
    - real source, not a copy - while excluding `WaddleHostAdapter.cs`/
    `ProcessStageExportsImpl.cs`/`ActionStageExportsImpl.cs`, which reference
    wit-bindgen-generated types that exist only inside an actual
    componentize-dotnet build (see `bundles/csharp/csping/README.md`
    "Spike results" for why no xUnit-testable C# bundle project exists
    upstream of this one). End-to-end compiled-component behavior (the parts
    this project cannot exercise) is covered instead by
    `core/bundle_executor/tests/csharp_superpenguin_alias_integration.rs`,
    mirroring `csharp_bundle_integration.rs`'s role for csping.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>WaddleBundleSuperpenguinAlias.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../sdk/waddle-sdk-cs/waddle-sdk-cs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../AliasLogic.cs" Link="AliasLogic.cs" />
    <Compile Include="../AliasJson.cs" Link="AliasJson.cs" />
    <Compile Include="../BundleKit.cs" Link="BundleKit.cs" />
    <Compile Include="../AliasDispatch.cs" Link="AliasDispatch.cs" />
    <!-- The SDK's own in-memory fakes (ledger with host-faithful wager idempotency, identity, tool, ...): real shared
         test source, linked rather than copied so the bundle tests exercise the same host model the SDK tests do. -->
    <Compile Include="../../../../sdk/waddle-sdk-cs/tests/Fakes.cs" Link="SdkFakes.cs" />
    <Compile Include="../../../../sdk/waddle-sdk-cs/tests/FakesNext.cs" Link="SdkFakesNext.cs" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  `dotnet-experimental` is required because `componentize-dotnet` compiles
  through the still-experimental NativeAOT-LLVM backend
  (dotnet/runtimelab `feature/NativeAOT-LLVM`); its `Microsoft.DotNet.
  ILCompiler.LLVM` package (and the per-RID `runtime.(rid).microsoft.
  dotnet.ilcompiler.llvm` package csping.csproj references) is published
  only to this feed, never to nuget.org: confirmed by querying nuget.org's
  own flat-container index for `microsoft.dotnet.ilcompiler.llvm`, which
  404s. This exact source list (plus ordering: `<clear />` first) mirrors
  `componentize-dotnet`'s own `dotnet new componentize.wasi.lib` template
  (github.com/bytecodealliance/componentize-dotnet
  templates/content/wasi-lib/nuget.config).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="dotnet-experimental" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

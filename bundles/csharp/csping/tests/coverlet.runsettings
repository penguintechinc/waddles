<?xml version="1.0" encoding="utf-8"?>
<!-- This test project links CspingLogic.cs/CspingDispatch.cs directly into
     the Csping.Tests assembly (see this directory's .csproj header comment
     for why: no separate wasi-wasm-compatible "csping" module exists to
     measure). coverlet's default `IncludeTestAssembly=false` would exclude
     that entire module, including CspingLogic/CspingDispatch, from coverage,
     silently reporting 0% for the very code this project exists to test
     (`critical-rules.md` Verification Integrity: "zero items examined is a
     FAILURE, not a pass"). `IncludeTestAssembly=true` fixes that; `[WaddleSdk]*`
     is excluded so the SDK's OWN (separately gated by `test-waddle-sdk-cs`)
     coverage doesn't dilute this project's number, and the `.Tests` namespace
     (xUnit test classes + local fakes, trivially 100% "covered" by
     definition) is excluded so the gate measures CspingLogic/CspingDispatch
     specifically, not the harness around them. `AutoGeneratedProgram`
     (xUnit's generated test-host entry point, unreachable by any test) is
     also excluded - unlike superpenguin-roll's much larger RollLogic
     (dice-game message tables), csping's tiny two-file surface means this
     one always-0%-covered generated line would otherwise be enough on its
     own to sink the 90% floor. Otherwise mirrors
     `bundles/csharp/superpenguin-roll/tests/coverlet.runsettings`. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <IncludeTestAssembly>true</IncludeTestAssembly>
          <Exclude>[*]*.g,[WaddleSdk]*,[Csping.Tests]WaddleBundleCsping.Tests.*,[Csping.Tests]AutoGeneratedProgram</Exclude>
          <ExcludeByFile>**/obj/**/*.g.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

{
  "contract": "ai-tools",
  "version": 1,
  "target_app_id": "waddles.core.service.ai",
  "doc": "Authoritative schemas for the AI service bundle tools (producer: bundles/rust/ai). Consumers (ai-teammates, dj) MUST send only fields in input_schema (additionalProperties=false), stay within its bounds, and read only fields in output_schema.required. Purpose/model selection is host-side, never a tool argument.",
  "tools": {
    "ai.complete": {
      "access": "read",
      "risk": "normal",
      "input_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3500
          },
          "system": {
            "type": "string",
            "maxLength": 1200
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "ai.classify": {
      "access": "read",
      "risk": "normal",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "minItems": 2,
            "maxItems": 20,
            "uniqueItems": true
          },
          "instructions": {
            "type": "string",
            "maxLength": 800
          }
        },
        "required": [
          "text",
          "labels"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "label",
          "confidence",
          "reason"
        ]
      }
    },
    "ai.rag.query": {
      "access": "read",
      "risk": "normal",
      "input_schema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,39}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "collection",
          "question"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 2000
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string"
                },
                "chunk": {
                  "type": "integer",
                  "minimum": 0
                },
                "score": {
                  "type": "number"
                }
              },
              "required": [
                "doc_id",
                "chunk"
              ]
            }
          }
        },
        "required": [
          "answer",
          "citations"
        ]
      }
    },
    "ai.rag.ingest": {
      "access": "write",
      "risk": "dangerous",
      "input_schema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,39}$"
          },
          "doc_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          }
        },
        "required": [
          "collection",
          "text"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "chunks": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "doc_id",
          "chunks"
        ]
      }
    }
  }
}

{
  "contract": "live-channels",
  "version": 1,
  "doc": "Every platform service bundle exports <platform>.live.channels (no arguments; community pinned host-side). Consumers (ai-teammates) read channels[].channel_id/live; title/game optional. Provisional: derived from the consumer fixture because the live-now producer is not yet pushed; the producer PR must conform (or amend this file in a reviewed change).",
  "platforms": [
    "discord",
    "twitch",
    "youtube"
  ],
  "tool": {
    "access": "read",
    "risk": "normal",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string"
              },
              "live": {
                "type": "boolean"
              },
              "title": {
                "type": "string"
              },
              "game": {
                "type": "string"
              }
            },
            "required": [
              "channel_id",
              "live"
            ]
          }
        }
      },
      "required": [
        "channels"
      ]
    }
  }
}

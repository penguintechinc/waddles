# core-bundle-seeder -- builds the first-party waddles.core.* example bundles to real WASI 0.2
# components, then packages them + their hub-api manifests + bundles/core-bundles.yaml into the
# hub-api runtime, with hub_api/cli/seed_core_bundles.py as the entrypoint.
#
# Multi-stage, rootless. Build (context = repo root; needs wit/, sdk/, bundles/, hub_api/):
#   docker build -f bundles/Dockerfile.core-bundles -t localhost:32000/waddlebot/core-bundle-seeder:alpha-<epoch> .
#
# Toolchain versions match this repo's own proven CI recipe verbatim
# (.github/workflows/rust-waddle-sdk-rs.yml's example-bundle-component job,
# .github/workflows/python-waddle-sdk.yml) -- cargo-component 0.21.1, wasm-tools 1.259.0, Rust
# 1.97.1, componentize-py==0.25.1.

# ---------------------------------------------------------------------------
# Stage 1: waddles.core.example.ping (Rust) -> WASI 0.2 component
# ---------------------------------------------------------------------------
FROM rust:1.97-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS rust-bundle-builder

# build-essential -- required to build `ring` (rustls's crypto provider), same as
# core/bundle_executor/Dockerfile.rust's own builder stage.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential=12.9 ca-certificates=20250419~deb12u1 \
    && rm -rf /var/lib/apt/lists/*

# Both targets, matching bundles/rust/ping/rust-toolchain.toml's own `targets` list exactly --
# if the toolchain file requests a target this explicit install doesn't already have, rustup's
# proxy shim auto-installs it ON DEMAND the first time `cargo`/`cargo component` runs (observed
# directly: `cargo component build` below failed reaching static.rust-lang.org for the
# wasm32-wasip1 manifest when only wasm32-wasip2 was pre-installed here). An implicit,
# unpinned, network-timed install is itself a nondeterminism/reliability source this Dockerfile
# otherwise goes out of its way to eliminate -- pre-installing both closes it.
RUN rustup toolchain install 1.97.1 --target wasm32-wasip2 --target wasm32-wasip1 --component rustfmt,clippy \
    && rustup default 1.97.1

# cargo-component/wasm-tools have no taiki-e/install-action binstall entry proven for this
# toolchain (see the CI workflow's own comment) -- installed from source at the exact pinned
# versions, --locked for full transitive-dependency pinning.
RUN cargo install cargo-component --version 0.21.1 --locked \
    && cargo install wasm-tools --version 1.259.0 --locked

WORKDIR /repo
COPY wit wit
COPY sdk/waddle-sdk-rs sdk/waddle-sdk-rs
COPY bundles/rust/ping bundles/rust/ping
WORKDIR /repo/bundles/rust/ping

# Reproducible-build pins -- proven byte-identical sha256 across two independent
# `--no-cache` builds (scripts/verify-core-bundles-reproducible.sh / `make
# verify-core-bundles-reproducible`, also run in CI on any change under this path -- see
# .github/workflows/core-bundles-reproducible.yml). Every
# knob below closes one specific nondeterminism source; `--locked` (already on the
# `cargo install`/`cargo component build` invocations above/below) plus the pinned
# `rust:1.97-slim-bookworm` digest and pinned cargo-component/wasm-tools versions handle
# toolchain/dependency-resolution determinism -- these env vars handle CODEGEN
# determinism, which `--locked` alone does not touch:
#   - SOURCE_DATE_EPOCH: fixes any timestamp rustc/LLVM would otherwise embed (e.g. in
#     debug info) to a constant instead of `date +%s` at build time.
#   - CARGO_INCREMENTAL=0: the incremental compilation cache is itself a
#     nondeterminism source (its on-disk layout is an optimization, not a spec) and
#     must never influence a from-scratch release build.
#   - RUSTFLAGS --remap-path-prefix (x2): erases this stage's absolute build path
#     (`/repo`, otherwise baked into `panic!()`/`debug_assert!()` location strings
#     even in a release cdylib) AND the crates.io registry source checkout path
#     (`$CARGO_HOME/registry/src/<index-hash>/...` -- the `<index-hash>` segment is
#     derived from the registry URL so it's already stable across hosts, but the
#     leading `$CARGO_HOME` prefix is not guaranteed to match between build
#     environments) so neither leaks into the component binary.
#   - -C codegen-units=1: parallel codegen units are LLVM's own documented source of
#     nondeterministic instruction/section ordering; forcing a single unit removes it.
#   - -C strip=symbols: drops the debug/symbol tables `wasm-tools` would otherwise
#     carry through verbatim (which can themselves embed compiler-version/path
#     metadata beyond what remap-path-prefix reaches).
#   - TZ/LC_ALL: defensive -- nothing in this build should read wall-clock time or
#     locale-dependent formatting, but pinning both means a future dependency
#     addition can't silently regress this without CI's reproducibility check catching it.
ENV SOURCE_DATE_EPOCH=1704067200 \
    CARGO_INCREMENTAL=0 \
    RUSTFLAGS="--remap-path-prefix=/repo=/build --remap-path-prefix=${CARGO_HOME}/registry/src=/cargo/registry/src -C codegen-units=1 -C strip=symbols" \
    TZ=UTC \
    LC_ALL=C.UTF-8
RUN cargo component build --release --target wasm32-wasip2 --locked

# ---------------------------------------------------------------------------
# Stage 2: waddles.core.example.pyping (Python) -> WASI 0.2 component
# ---------------------------------------------------------------------------
FROM python:3.13-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26 AS python-bundle-builder

RUN pip install --no-cache-dir componentize-py==0.25.1

WORKDIR /repo
COPY wit wit
COPY sdk/waddle-sdk/src sdk/waddle-sdk/src
COPY bundles/python/pyping/src bundles/python/pyping/src
# waddle_sdk._component_entry -- the shared SDK entry module every Python bundle points
# componentize-py at (PR #382, fix/python-sdk-two-export-entry, merged into release/v3.0.X);
# supersedes this bundle's own now-deleted _wit_app.py stand-in. bundles/python/pyping/src/
# _entry_wiring.py (added by that same merge) supplies the static bundle_transform/
# bundle_dispatch wiring _component_entry.py expects from the bundle's own source directory.
#
# Reproducible-build pins (same proof requirement as rust-bundle-builder above --
# scripts/verify-core-bundles-reproducible.sh / `make verify-core-bundles-reproducible`).
# componentize-py wizens a real CPython interpreter (imports every bundled module, then
# snapshots its post-import state into the component's linear memory), so unlike a plain
# compiler invocation, ambient Python hashing/locale/clock state is directly bakeable into
# the emitted component bytes:
#   - PYTHONHASHSEED=0: str/bytes hashing is randomized per-process by default (PYTHONHASHSEED
#     unset picks a random seed at interpreter start) -- that seed drives internal dict/set
#     bucket layout, which the wizened snapshot's iteration order (module __dict__ enumeration,
#     any set-backed structure componentize-py or CPython's own import machinery touches) can
#     expose as differently-ordered bytes across two otherwise-identical runs.
#   - PYTHONDONTWRITEBYTECODE=1: stops CPython writing __pycache__/*.pyc siblings during the
#     import pass; componentize-py bundles compiled code objects directly (not .pyc files), but
#     a stray .pyc header embeds its source mtime, so this only matters if a future change reads
#     bytecode back from disk instead of recompiling in-memory -- defensive, zero cost either way.
#   - SOURCE_DATE_EPOCH: same constant as the Rust stage -- fixes any wall-clock timestamp a
#     dependency's import-time code might otherwise embed (e.g. a `datetime.now()` default
#     baked into a class attribute at import).
#   - TZ/LC_ALL: defensive, mirrors the Rust stage's own rationale -- nothing here should read
#     wall-clock/locale state, but pinning both means a future dependency addition can't
#     silently regress this without CI's reproducibility check catching it.
ENV PYTHONHASHSEED=0 \
    PYTHONDONTWRITEBYTECODE=1 \
    SOURCE_DATE_EPOCH=1704067200 \
    TZ=UTC \
    LC_ALL=C.UTF-8
RUN componentize-py \
        -d wit/waddle-bundle -w stage \
        componentize -p sdk/waddle-sdk/src -p bundles/python/pyping/src \
        waddle_sdk._component_entry \
        -o pyping.wasm

# ---------------------------------------------------------------------------
# Stage 2b: waddles.core.quotes.default (Python) -> WASI 0.2 component
#
# Built FROM python-bundle-builder (stage 2) to reuse its already-installed,
# pinned componentize-py==0.25.1 rather than a second pip install of the same
# version -- same toolchain, new bundle source only.
# ---------------------------------------------------------------------------
FROM python-bundle-builder AS python-quotes-bundle-builder

COPY bundles/python/quotes/src bundles/python/quotes/src
# Same waddle_sdk._component_entry / _entry_wiring.py wiring as the pyping stage above
# (see that stage's own comment) -- bundles/python/quotes/src/_entry_wiring.py supplies the
# static bundle_transform/bundle_dispatch wiring for THIS bundle's own transform()/dispatch().
RUN componentize-py \
        -d wit/waddle-bundle -w stage \
        componentize -p sdk/waddle-sdk/src -p bundles/python/quotes/src \
        waddle_sdk._component_entry \
        -o quotes.wasm

# ---------------------------------------------------------------------------
# Stage 3: hub-api's own Python dependency set (+ wasm-tools CLI) -- mirrors
# hub_api/Dockerfile's builder stage verbatim, same pinned base per
# devops-containers.md ("never a second pinned digest for the same tag").
# ---------------------------------------------------------------------------
FROM python:3.13-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26 AS hub-deps-builder
WORKDIR /app

COPY hub_api/requirements.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

COPY libs/flask_core /app/libs/flask_core
RUN pip install --no-cache-dir /app/libs/flask_core

# wasm-tools -- the seeder's own bundle_component_validator.validate_component() shells out to
# this CLI (same WIT-conformance check hub-api's own onboarding endpoint uses); pinned +
# checksum-verified identically to hub_api/Dockerfile's own install.
ARG WASM_TOOLS_VERSION=1.259.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) wt_arch=x86_64; wt_sha256=3e9b374b4c7715b771b69bf0d65a337990ed4546ec5e97e01c0ff587dfc52160 ;; \
      arm64) wt_arch=aarch64; wt_sha256=9e1644f3841f2b783dd8af82de054667388e46689806fba4909ed45f3182800f ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/bytecodealliance/wasm-tools/releases/download/v${WASM_TOOLS_VERSION}/wasm-tools-${WASM_TOOLS_VERSION}-${wt_arch}-linux.tar.gz"; \
    python3 -c "import urllib.request; urllib.request.urlretrieve('${url}', '/tmp/wasm-tools.tar.gz')"; \
    echo "${wt_sha256}  /tmp/wasm-tools.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/wasm-tools.tar.gz -C /tmp; \
    install -m 0755 "/tmp/wasm-tools-${WASM_TOOLS_VERSION}-${wt_arch}-linux/wasm-tools" /usr/local/bin/wasm-tools; \
    rm -rf /tmp/wasm-tools.tar.gz "/tmp/wasm-tools-${WASM_TOOLS_VERSION}-${wt_arch}-linux"

# ---------------------------------------------------------------------------
# Final: hub-api runtime + the two built components + their manifests + the catalog.
# ---------------------------------------------------------------------------
FROM python:3.13-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26
WORKDIR /app

COPY --from=hub-deps-builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=hub-deps-builder /usr/local/bin /usr/local/bin

COPY hub_api/config.py ./
COPY hub_api/services ./services
COPY hub_api/cli ./cli

RUN mkdir -p /core-bundles
COPY bundles/core-bundles.yaml /core-bundles/core-bundles.yaml
COPY bundles/rust/ping/hub-manifest.yaml /core-bundles/ping.manifest.yaml
COPY bundles/python/pyping/hub-manifest.yaml /core-bundles/pyping.manifest.yaml
COPY bundles/python/quotes/hub-manifest.yaml /core-bundles/quotes.manifest.yaml
COPY --from=rust-bundle-builder /repo/bundles/rust/ping/target/wasm32-wasip2/release/waddle_bundle_ping_rust.wasm /core-bundles/ping.wasm
COPY --from=python-bundle-builder /repo/pyping.wasm /core-bundles/pyping.wasm
COPY --from=python-quotes-bundle-builder /repo/quotes.wasm /core-bundles/quotes.wasm

ENV CORE_BUNDLES_DIR=/core-bundles

RUN groupadd -r appuser && useradd -r -g appuser -m appuser \
    && chown -R appuser:appuser /app /core-bundles

# Remove base image's own bundled pip + ensurepip wheel: pip vendors an
# outdated msgpack (GHSA-6v7p-g79w-8964) and pkg_resources/setuptools
# (CVE-2025-47273) that the upstream python:3.13-slim-bookworm rebuild
# hasn't picked up yet. Neither pip nor its vendor tree is imported by
# any service at runtime (installs happen at build time via uv/pip
# above), so removing them is a real fix, not a suppression.
RUN rm -rf /usr/local/lib/python3.13/site-packages/pip \
    /usr/local/lib/python3.13/site-packages/pip-*.dist-info \
    /usr/local/lib/python3.13/ensurepip

USER appuser

ENTRYPOINT ["python3", "-m", "cli.seed_core_bundles"]

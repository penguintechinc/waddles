{
  "name": "waddlebot-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for Waddles multi-service workflows",
  "scripts": {
    "test": "jest --runInBand --verbose --testTimeout=30000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "axios": "1.20.0",
    "ioredis": "5.3.2",
    "pg": "8.11.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "jest": "30.4.2"
  }
}

{
  "name": "waddlebot-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for Waddles multi-service workflows",
  "scripts": {
    "test": "jest --runInBand --verbose --testTimeout=30000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "axios": "1.20.0",
    "ioredis": "5.3.2",
    "pg": "8.11.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "jest": "30.4.2"
  },
  "overrides": {
    "minimatch@^9.0.0": "11.0.3",
    "brace-expansion@^5.0.0": "5.0.12",
    "@isaacs/nonrecursive-glob-match": "1.0.1",
    "js-yaml@^3.0.0": "3.15.2",
    "brace-expansion@^1.0.0": "1.1.21",
    "glob@^10.0.0": "14.0.3",
    "minimatch@^11.0.0": "11.0.3"
  }
}

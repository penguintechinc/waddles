{
  "name": "waddlebot-api-tests",
  "version": "1.0.0",
  "description": "API integration tests for Waddles Hub Backend",
  "scripts": {
    "test": "jest --runInBand --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./setup.js"
    ],
    "collectCoverageFrom": [
      "../../../admin/hub_module/backend/src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "jest": "30.4.2",
    "nock": "14.0.16",
    "supertest": "7.2.2"
  }
}

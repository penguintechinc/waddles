{
  "name": "waddlebot-api-tests",
  "version": "1.0.0",
  "description": "API integration tests for Waddles Hub Backend",
  "scripts": {
    "test": "jest --runInBand --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./setup.js"
    ],
    "collectCoverageFrom": [
      "../../../admin/hub_module/backend/src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "jest": "30.4.2",
    "nock": "14.0.16",
    "supertest": "7.2.2"
  },
  "overrides": {
    "minimatch@^9.0.0": "11.0.3",
    "brace-expansion@^5.0.0": "5.0.12",
    "@isaacs/nonrecursive-glob-match": "1.0.1",
    "js-yaml@^3.0.0": "3.15.2",
    "brace-expansion@^1.0.0": "1.1.21",
    "qs": "6.16.1",
    "glob@^10.0.0": "14.0.3",
    "minimatch@^11.0.0": "11.0.3"
  }
}
